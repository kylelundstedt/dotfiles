# Second sshd instance on klundstedt-mini, exclusively for the mosh/Moshi
# bootstrap path (Tailscale SSH owns port 22 but cannot bootstrap mosh —
# see agent_docs/herdr-pilot.md). Installed to /etc/ssh/sshd_moshi_config
# by install-sshd-moshi.sh; run by the dev.klundstedt.sshd-moshi LaunchDaemon.
#
# Posture: tailnet-only (ListenAddress = the mini's Tailscale IP), pubkey-only,
# one allowed user, no forwarding, and a dedicated authorized_keys file so this
# port trusts phone keys and nothing else.

Port 2222
ListenAddress 100.123.154.23

HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_ecdsa_key

AllowUsers klundstedt
PermitRootLogin no

PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys_moshi
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM yes

AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTTY yes
PrintMotd no
