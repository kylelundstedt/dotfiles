<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.klundstedt.sshd-moshi</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/sbin/sshd</string>
		<string>-D</string>
		<string>-e</string>
		<string>-f</string>
		<string>/etc/ssh/sshd_moshi_config</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- KeepAlive also covers boot ordering: binding to the Tailscale IP fails
	     until tailscaled brings the interface up; launchd retries until it wins. -->
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/sshd-moshi.log</string>
</dict>
</plist>
