# SSH Config File (template)

## Canonicalize MagicDNS short names to FQDNs (added by install.sh)
## e.g. `ssh my-vm` becomes `ssh my-vm.<tailnet>.ts.net`, matching ForwardAgent rule
CanonicalizeHostname yes
CanonicalDomains <tailnet>.ts.net
CanonicalizeMaxDots 0

## GitHub SSH multiplexing (added by install.sh)
Host github.com
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 600

## exe.dev multiplexing (added by install.sh)
## Both the lobby (exe.dev) and direct VM SSH (*.exe.xyz) silently rate-limit
## new TCP connections per source IP. One persistent connection carries many
## commands and stays under the threshold.
Host exe.dev *.exe.xyz
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 600

## exe.dev — pin to dedicated key to avoid 1Password agent offering wrong keys
Host exe.dev *.exe.xyz
  IdentitiesOnly yes
  IdentityFile ~/.ssh/exe_dev.pub

## exe.dev dev VMs — default to exedev (exeuntu image) over both direct + Tailscale names
## (added by install.sh; *.<tailnet>.ts.net is filled in from `tailscale status`)
Host *.exe.xyz *.<tailnet>.ts.net
  User exedev

## MCP OAuth callback forward — *.exe.xyz only.
## Scoped narrow so routine `ssh <vm>` (Tailscale) connections don't race for
## port 8765 against Zed's persistent remote-server SSH.
## For OAuth flows, use `ssh <vm>.exe.xyz` explicitly.
Host *.exe.xyz
  LocalForward 8765 localhost:8765

## Forward SSH agent to Tailscale VMs (Apple Containers, Sprites, exe.dev)
Host *.ts.net
  ForwardAgent yes

Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

