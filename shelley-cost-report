#!/usr/bin/env python3
"""Estimate exe.dev gateway cost from observed Shelley usage."""

from __future__ import annotations

import argparse
import json
import re
import sqlite3
import sys
import urllib.error
import urllib.request
from collections.abc import Iterable
from datetime import datetime, timezone
from pathlib import Path

DEFAULT_DB = Path.home() / ".config" / "shelley" / "shelley.db"
PRICE_URL = "https://exe.dev/llm-gateway-models.json"
DEFAULT_MODELS = (
    "claude-fable-5",
    "claude-opus-4-8",
    "claude-sonnet-5",
    "gpt-5.6-sol",
    "accounts/fireworks/models/glm-5p2",
    "grok-4.5",
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Apply current exe.dev gateway prices to token usage recorded in "
            "Shelley's SQLite database."
        )
    )
    parser.add_argument("--db", type=Path, default=DEFAULT_DB)
    parser.add_argument("--hours", type=float, default=24.0)
    parser.add_argument("--conversation", help="limit to one conversation ID")
    parser.add_argument("--all", action="store_true", help="show every gateway model")
    return parser.parse_args()


def load_usage(
    db: Path, hours: float, conversation: str | None
) -> tuple[dict[str, float], str | None]:
    if hours <= 0:
        raise ValueError("--hours must be greater than zero")
    if not db.exists():
        raise FileNotFoundError(f"Shelley database not found: {db}")

    where = [
        "model_name IS NOT NULL",
        "usage_data IS NOT NULL",
        "created_at >= datetime('now', ?)",
    ]
    params: list[object] = [f"-{hours} hours"]
    if conversation:
        where.append("conversation_id = ?")
        params.append(conversation)

    query = f"""
        SELECT usage_data
        FROM messages
        WHERE {' AND '.join(where)}
    """
    totals = {
        "requests": 0.0,
        "input": 0.0,
        "cache_read": 0.0,
        "cache_write": 0.0,
        "output": 0.0,
        "recorded_cost": 0.0,
    }
    with sqlite3.connect(f"file:{db}?mode=ro", uri=True) as connection:
        db_started = connection.execute(
            "SELECT min(executed_at) FROM migrations"
        ).fetchone()[0]
        for (raw_usage,) in connection.execute(query, params):
            usage = json.loads(raw_usage)
            totals["requests"] += 1
            totals["input"] += usage.get("input_tokens", 0) or 0
            totals["cache_read"] += usage.get("cache_read_input_tokens", 0) or 0
            totals["cache_write"] += usage.get("cache_creation_input_tokens", 0) or 0
            totals["output"] += usage.get("output_tokens", 0) or 0
            totals["recorded_cost"] += usage.get("cost_usd", 0) or 0
    return totals, db_started


def load_prices() -> list[dict[str, object]]:
    request = urllib.request.Request(PRICE_URL, headers={"User-Agent": "shelley-cost-report"})
    with urllib.request.urlopen(request, timeout=15) as response:
        document = json.load(response)

    models: list[dict[str, object]] = []
    for provider in document["providers"]:
        for model in provider["models"]:
            if not model.get("cost"):
                continue
            models.append(
                {
                    "provider": provider["id"],
                    "id": model["id"],
                    "name": model.get("name") or model["id"],
                    "cost": model["cost"],
                }
            )
    return models


def select_models(
    models: Iterable[dict[str, object]], show_all: bool
) -> list[dict[str, object]]:
    models_by_id = {str(model["id"]): model for model in models}
    if show_all:
        return sorted(models_by_id.values(), key=lambda model: str(model["id"]))
    return [models_by_id[model_id] for model_id in DEFAULT_MODELS if model_id in models_by_id]


def estimate_cost(usage: dict[str, float], rates: dict[str, float]) -> float:
    return (
        usage["input"] * rates.get("input", 0)
        + usage["cache_read"] * rates.get("cacheRead", 0)
        + usage["cache_write"] * rates.get("cacheWrite", 0)
        + usage["output"] * rates.get("output", 0)
    ) / 1_000_000


def format_tokens(value: float) -> str:
    return f"{int(value):,}"


def main() -> int:
    args = parse_args()
    try:
        usage, db_started = load_usage(
            args.db.expanduser(), args.hours, args.conversation
        )
        models = select_models(load_prices(), args.all)
    except (FileNotFoundError, ValueError, sqlite3.Error, urllib.error.URLError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1

    scope = f"conversation {args.conversation}, " if args.conversation else ""
    print(f"Observed Shelley usage ({scope}last {args.hours:g} hours)")
    db_age_hours: float | None = None
    if db_started:
        # Drop sub-second precision so this parses under any python3: 3.9's
        # fromisoformat rejects fractions that aren't 3 or 6 digits, and DB
        # timestamps strip trailing zeros (e.g. ".57173"). Age is in hours.
        started = datetime.fromisoformat(
            re.sub(r"\.\d+", "", db_started)
        ).replace(tzinfo=timezone.utc)
        db_age_hours = (datetime.now(timezone.utc) - started).total_seconds() / 3600
        print(f"  database age: {db_age_hours:.1f} hours (started {db_started} UTC)")
    print(f"  requests:     {int(usage['requests']):,}")
    print(f"  input:        {format_tokens(usage['input'])}")
    print(f"  cache reads:  {format_tokens(usage['cache_read'])}")
    print(f"  cache writes: {format_tokens(usage['cache_write'])}")
    print(f"  output:       {format_tokens(usage['output'])}")
    print(f"  recorded:     ${usage['recorded_cost']:.2f}")

    if not usage["requests"]:
        return 0

    projection_reliable = (
        args.hours >= 24
        and (db_age_hours is None or db_age_hours >= args.hours * 0.95)
    )
    projection_factor = 30 * 24 / args.hours
    rows = []
    for model in models:
        rates = model["cost"]
        assert isinstance(rates, dict)
        window_cost = estimate_cost(usage, rates)
        monthly_cost = window_cost * projection_factor if projection_reliable else None
        rows.append(
            (
                str(model["name"]),
                str(model["provider"]),
                window_cost,
                monthly_cost,
            )
        )

    print("\nCounterfactual exe.dev gateway cost")
    print(f"{'model':42} {'provider':10} {'window':>10} {'30d linear':>12}")
    for name, provider, window_cost, monthly_cost in rows:
        projected = f"${monthly_cost:11.2f}" if monthly_cost is not None else f"{'n/a':>12}"
        print(f"{name[:42]:42} {provider[:10]:10} ${window_cost:9.2f} {projected}")

    if not projection_reliable:
        if args.hours < 24:
            reason = "a window of at least 24 hours is required"
        else:
            reason = (
                f"the database is only {db_age_hours:.1f} hours old, shorter than "
                f"the requested {args.hours:g}-hour window"
            )
        print(f"\nNo monthly projection: {reason}.")

    print(
        "\nEstimate only: different models produce different tokenization, tool-call "
        "trajectories, and success rates. Validate with matched end-to-end tasks."
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
