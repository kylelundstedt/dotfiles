#!/usr/bin/env bash
# Fail-closed check: no repo anywhere in the fleet holds an unpushed Entire
# checkpoint.
#
# Why this exists. Entire records the "why" of agent work on a git ref
# (entire/checkpoints/*) and ships it via a pre-push hook. That makes it durable
# — but ONLY on push. A repo that has been checkpointed and never pushed has an
# Entire record with zero durability: it dies with the VM, silently, and no
# existing check notices. Found for real on 2026-07-28, when iv-foundry-stage2
# held 5 unpushed checkpoints on kylelundstedt/fannie-sflpd.
# See agent_docs/vm-disposability.md.
#
# This is the Entire half of the pair; agentsview-coverage is the AgentsView
# half. Together they assert that both safety nets are WORKING, not merely
# installed.
#
# Runs on the mini; self-skips elsewhere. Pass --dry-run to print findings
# without pinging.
set -uo pipefail
umask 077

DRY_RUN=0
[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=1

source "$HOME/dotfiles/backup/_lib.sh"
job_require_mini entire-push-check
[[ $DRY_RUN -eq 1 ]] || { job_hc_init "entire-push-check:healthcheck-url"; job_log "$HOME/Library/Logs/entire-push-check"; }

fail() {
    echo "FAIL: $1"
    [[ $DRY_RUN -eq 1 ]] || job_hc /fail --data-raw "entire-push-check $(date '+%F %T') $1"
    exit 1
}

command -v jq >/dev/null 2>&1 || fail "jq not found"

# Scratch clones that legitimately hold an unpushable Entire ref — e.g. a
# throwaway snapshot whose main is an unrelated history, where pushing the
# checkpoint ref would diverge or clobber the real one. One "host:repo" per
# line. Same fail-closed spirit as agentsview-coverage-exclude.txt: excuse a
# repo only when its record genuinely does not need to survive, never to
# silence one you simply have not pushed.
EXCLUDE_FILE="$HOME/dotfiles/provisioning/entire-push-exclude.txt"
EXCLUDED=()
if [[ -f "$EXCLUDE_FILE" ]]; then
    while IFS= read -r e; do [[ -n "$e" ]] && EXCLUDED+=("$e"); done < <(
        grep -vE '^[[:space:]]*#|^[[:space:]]*$' "$EXCLUDE_FILE")
fi

# The probe, run on each host. Deliberately uses absolute paths and no
# `command -v`: non-interactive SSH gets a PATH without ~/.local/bin, which
# silently reports user-installed tools as absent (agent_docs/vm-disposability.md).
# Finds worktrees too — a linked worktree's .git is a FILE, not a directory.
#
# Emits `repo|common-dir|ref|n`. The common-dir is what makes the finding
# COUNTABLE: linked worktrees share one object store, so N worktrees of the
# same repo each report the same refs, and a naive count multiplies one
# undurable record into N. Measured on iv-foundry-stage2 2026-08-21: 15
# findings, 3 actual refs — seven ave-adapters worktrees all resolving to
# ave-adapters-native/.git. Reporting 15 things to fix when there are 3 is how
# a fail-closed check stops being read.
read -r -d '' PROBE <<'EOS'
find "$HOME" -name .git -maxdepth 6 \( -type d -o -type f \) 2>/dev/null | while read -r g; do
    r="$(dirname "$g")"
    git -C "$r" rev-parse --git-dir >/dev/null 2>&1 || continue
    # The shared object store. --path-format=absolute needs git >= 2.31; the
    # fallback resolves it by hand for anything older, since --git-common-dir
    # alone returns a bare ".git" for a main worktree and an absolute path for a
    # linked one, which would not group.
    c=$(git -C "$r" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || c=""
    [ -n "$c" ] || c=$(cd "$r" && cd "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null && pwd -P) || c=""
    [ -n "$c" ] || c="$r/.git"
    # 'refs/heads/entire/**', not 'entire/*': for-each-ref patterns are
    # pathname-aware, so a single * stops at the slash and matches NOTHING
    # under entire/checkpoints/v1 — the check passed vacuously until this was
    # caught by a synthetic unpushed checkpoint.
    git -C "$r" for-each-ref --format='%(refname:short)' 'refs/heads/entire/**' 2>/dev/null | while read -r ref; do
        [ -n "$ref" ] || continue
        n=$(git -C "$r" rev-list --count "$ref" --not --remotes 2>/dev/null || echo 0)
        [ "$n" -gt 0 ] && echo "${r#"$HOME"/}|${c#"$HOME"/}|$ref|$n"
    done
done
EOS

TS_BIN=$(command -v tailscale || true)
[[ -n "$TS_BIN" ]] || [[ ! -x /opt/homebrew/bin/tailscale ]] || TS_BIN=/opt/homebrew/bin/tailscale
[[ -n "$TS_BIN" ]] || fail "tailscale not installed"

TS_JSON=$($TS_BIN status --json 2>/dev/null) || fail "tailscale status unavailable"
TAILNET=()
while IFS= read -r h; do [[ -n "$h" ]] && TAILNET+=("$h"); done < <(
    jq -r '.Peer[]? | select(.Online == true and .OS == "linux") | .HostName' <<<"$TS_JSON" | sort -u)

# Authoritative VM list, same two-attempt/backoff discipline as
# agentsview-coverage: exe.dev drops SYNs past an undocumented per-IP rate.
EXE_JSON=""
for attempt in 1 2; do
    EXE_JSON=$(ssh -o ConnectTimeout=25 -o BatchMode=yes exe.dev ls --json 2>/dev/null) && [[ -n "$EXE_JSON" ]] && break
    EXE_JSON=""
    [[ $attempt -eq 1 ]] && sleep 45
done
[[ -n "$EXE_JSON" ]] || fail "exe.dev inventory unavailable after 2 attempts"

EXEVMS=()
while IFS= read -r h; do [[ -n "$h" ]] && EXEVMS+=("$h"); done < <(
    jq -r '.vms[]? | select(.status == "running") | .vm_name' <<<"$EXE_JSON" | sort -u)

in_list() { local h=$1; shift; local x; for x in "$@"; do [[ "$x" == "$h" ]] && return 0; done; return 1; }

findings=() checked=0 unreachable=() excused_n=0
# Parallel arrays, not an associative array: the mini's /bin/bash is 3.2, which
# has no `declare -A`. SEEN holds "host|common-dir|ref" for each finding already
# recorded; SEEN_EXTRA counts the additional worktrees that resolved to it.
SEEN=() SEEN_EXTRA=() dup_n=0

index_of() {  # index_of <needle> <haystack...> -> echoes index, or -1
    local needle=$1; shift
    local i=0 x
    for x in "$@"; do
        [[ "$x" == "$needle" ]] && { echo "$i"; return 0; }
        i=$((i + 1))
    done
    echo -1
}

record() {  # record <host> <probe-output>
    local host=$1 out=$2 line repo common ref n key idx
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        IFS='|' read -r repo common ref n <<<"$line"
        [[ -n "$repo" && -n "$ref" ]] || continue

        # Exclusions are still matched per WORKTREE path, before dedupe, so the
        # existing host:repo entries in entire-push-exclude.txt keep their exact
        # meaning. Excusing one worktree of a shared repo does not excuse the
        # others; the survivors simply collapse into a single finding below.
        key="$host:$repo"
        if in_list "$key" ${EXCLUDED[@]+"${EXCLUDED[@]}"}; then
            excused_n=$((excused_n + 1))
            [[ $DRY_RUN -eq 1 ]] && echo "  excused  $key"
            continue
        fi

        # One undurable record per (host, object store, ref) -- NOT per
        # worktree. Linked worktrees share refs, so without this a repo with
        # seven worktrees reports seven identical findings and the operator is
        # told to push seven things that are one thing.
        key="$host|$common|$ref"
        idx=$(index_of "$key" ${SEEN[@]+"${SEEN[@]}"})
        if [[ "$idx" != "-1" ]]; then
            SEEN_EXTRA[$idx]=$(( ${SEEN_EXTRA[$idx]} + 1 ))
            dup_n=$((dup_n + 1))
            [[ $DRY_RUN -eq 1 ]] && echo "  (also in $host:$repo, same object store)"
            continue
        fi
        SEEN+=("$key")
        SEEN_EXTRA+=(0)
        findings+=("$host:$repo|$ref|$n")
    done <<<"$out"
}

# The mini itself — repos here can carry Entire refs too.
out=$(bash -c "$PROBE" 2>/dev/null); checked=$((checked + 1))
[[ -n "$out" ]] && record "$(hostname -s)" "$out"

# Tailnet hosts: WireGuard, not exe.dev's edge — parallel is fine, but keep it
# simple and serial here; the fleet is small and this runs daily.
for h in ${TAILNET[@]+"${TAILNET[@]}"}; do
    out=$(ssh -o ConnectTimeout=15 -o BatchMode=yes "$h" "$PROBE" 2>/dev/null)
    if [[ $? -ne 0 && -z "$out" ]]; then unreachable+=("$h"); continue; fi
    checked=$((checked + 1))
    [[ -n "$out" ]] && record "$h" "$out"
done

# exe.dev VMs that are NOT tailnet peers — reachable only via *.exe.xyz.
# Strictly serial with a pause: this is the rate-limited path.
first=1
for h in ${EXEVMS[@]+"${EXEVMS[@]}"}; do
    in_list "$h" ${TAILNET[@]+"${TAILNET[@]}"} && continue
    [[ $first -eq 1 ]] || sleep 20
    first=0
    out=$(ssh -o ConnectTimeout=30 -o BatchMode=yes -o StrictHostKeyChecking=accept-new "$h.exe.xyz" "$PROBE" 2>/dev/null)
    if [[ $? -ne 0 && -z "$out" ]]; then unreachable+=("$h"); continue; fi
    checked=$((checked + 1))
    [[ -n "$out" ]] && record "$h" "$out"
done

for u in ${unreachable[@]+"${unreachable[@]}"}; do
    echo "  note: $u unreachable — not inspected"
done

if [[ ${#findings[@]} -gt 0 ]]; then
    i=0
    for f in "${findings[@]}"; do
        extra=${SEEN_EXTRA[$i]:-0}
        if [[ $extra -gt 0 ]]; then
            echo "  UNPUSHED $f (+${extra} more worktree(s) sharing this ref)"
        else
            echo "  UNPUSHED $f"
        fi
        i=$((i + 1))
    done
    # Count distinct refs, and say so. "18 unpushed checkpoints" for three refs
    # reads as a much larger backlog than it is, and an alert that overstates
    # its own severity is one you learn to discount.
    dupnote=""
    [[ $dup_n -gt 0 ]] && dupnote=" (${dup_n} duplicate worktree finding(s) collapsed)"
    fail "${#findings[@]} unpushed Entire checkpoint ref(s)${dupnote}: ${findings[*]} — push the repo so the record leaves the host"
fi

[[ $DRY_RUN -eq 1 ]] || job_hc
echo "OK: ${checked} host(s) inspected, 0 unpushed Entire checkpoints, ${excused_n} excused, ${#unreachable[@]} unreachable"
