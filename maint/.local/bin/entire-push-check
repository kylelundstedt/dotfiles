#!/usr/bin/env bash
# Scheduling wrapper for iv-provision's entire-push-check.
#
# THE CHECK ITSELF LIVES IN iv-provision (bin/entire-push-check), because what
# it inspects -- the pinned Entire CLI and its checkpoint refs -- is installed by
# that repo, and because it must run from any host that can reach the fleet. It
# used to live here and sourced this repo's job harness, which meant a
# fleet-wide check refused to run anywhere except this laptop.
#
# What stays here is the personal scheduling concern: the launchd job, the
# healthchecks.io ping (URL in the login Keychain), and the log. The dead-man's
# switch matters -- if this stops running, healthchecks.io alerts -- and it has
# no business in a team repo.
#
# Pass --dry-run to print findings without pinging.
set -uo pipefail
umask 077

DRY_RUN=0
[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=1

source "$HOME/dotfiles/backup/_lib.sh"
job_require_mini entire-push-check
[[ $DRY_RUN -eq 1 ]] || { job_hc_init "entire-push-check:healthcheck-url"; job_log "$HOME/Library/Logs/entire-push-check"; }

# Resolve the check. Not $HOME-relative guessing: name the candidates, and fail
# LOUDLY if none is present. A wrapper that silently no-ops when the checkout
# moved would report green forever -- the exact failure mode this pair of checks
# exists to prevent.
CHECK=""
for c in "$HOME/github/kylelundstedt/iv-provision/bin/entire-push-check" \
         "$HOME/iv-provision/bin/entire-push-check"; do
    [[ -x "$c" ]] && { CHECK="$c"; break; }
done

if [[ -z "$CHECK" ]]; then
    msg="iv-provision checkout not found; cannot run entire-push-check"
    echo "FAIL: $msg"
    [[ $DRY_RUN -eq 1 ]] || job_hc /fail --data-raw "entire-push-check $(date '+%F %T') $msg"
    exit 1
fi

out=$("$CHECK" ${DRY_RUN:+$([[ $DRY_RUN -eq 1 ]] && echo --dry-run)} 2>&1)
rc=$?
printf '%s\n' "$out"

if [[ $rc -ne 0 ]]; then
    [[ $DRY_RUN -eq 1 ]] || job_hc /fail --data-raw "entire-push-check $(date '+%F %T') $(printf '%s' "$out" | tail -3)"
    exit "$rc"
fi

[[ $DRY_RUN -eq 1 ]] || job_hc
