#!/usr/bin/env bash
# Daily state digest: what is red, for how long, and whether the things that are
# supposed to be protecting data actually ran.
#
# WHY THIS EXISTS (2026-09-15). healthchecks.io alerts on the TRANSITION into
# DOWN, so a check that is already red never alerts again. tigris-backup was red
# for 41 days; when its failure got much worse on 08-27 -- the backup stopped
# completing, four archive phases were skipped nightly, the weekly verify was
# blocked -- that produced exactly the same silence as the day before, and
# eleven days passed before anyone looked. monitoring-meta (added the same day)
# buys ONE extra transition when a check has been stuck for days. It does not
# report state on a schedule. This does.
#
# DELIVERY. This composes the report; it does not invent a transport. The mini
# has no configured mail path (no msmtp, no ntfy, postfix unconfigured), and a
# digest written somewhere nobody looks is the same "configured but inert" trap
# this whole family of bugs came from. So:
#   - the report is logged dated, giving history that neither healthchecks.io nor
#     a transition-based alert retains;
#   - it is attached to this job's success ping, so it is retrievable from the
#     healthchecks.io ping log;
#   - and the REPEATING delivery is healthchecks.io's own, which does exactly
#     this natively: Account Settings > Email Reports > daily reports, plus
#     "daily reminders as long as there are any checks down". That is
#     vendor-native, state-based, uses the email channel already configured, and
#     cannot rot. Enable it there rather than reimplementing it here.
# If push (phone) is ever wanted instead, ntfy or msmtp would slot in at the
# marked point below -- deliberately not added, because both need a decision:
# ntfy publishes job names to a third party, msmtp needs an app password.
#
# Pass --dry-run to print without pinging or logging.
set -uo pipefail
umask 077

DRY_RUN=0
[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=1

source "$HOME/dotfiles/backup/_lib.sh"
job_require_mini monitoring-digest
[[ $DRY_RUN -eq 1 ]] || { job_hc_init "monitoring-digest:healthcheck-url"; job_log "$HOME/Library/Logs/monitoring-digest"; }

STATE="$HOME/Library/Application Support/check-monitoring/down-since.tsv"
EXT=${EXT:-/Volumes/OWC8TB}
NOW=$(date +%s)

fail() {
    echo "FAIL: $1"
    [[ $DRY_RUN -eq 1 ]] || job_hc /fail --data-raw "monitoring-digest $(date '+%F %T') $1"
    exit 1
}

KEY=$(job_kc "healthchecks:api-key")
[[ -n "$KEY" ]] || fail "healthchecks:api-key not in Keychain — cannot read check state"
command -v jq >/dev/null 2>&1 || fail "jq not found"
API=$(curl -fsS -m 20 -H "X-Api-Key: $KEY" https://healthchecks.io/api/v3/checks/) \
    || fail "healthchecks API unreachable"

age() { # seconds -> compact human
    local s=$1
    if   (( s < 3600  )); then echo "$(( s / 60 ))m"
    elif (( s < 86400 )); then echo "$(( s / 3600 ))h"
    else echo "$(( s / 86400 ))d$(( (s % 86400) / 3600 ))h"; fi
}

echo "=== monitoring digest $(date '+%F %T %Z') ==="
echo

# ---- checks ---------------------------------------------------------------
# Sorted so anything not "up" is listed first: the digest has to lead with the
# problem, or it reads as reassurance.
red=0; total=0
echo "CHECKS"
while IFS=$'\t' read -r name status last; do
    [[ -z "$name" ]] && continue
    total=$(( total + 1 ))
    if [[ "$last" == "null" || -z "$last" ]]; then
        last_age="never pinged"
    else
        # -u: the API returns UTC; without it macOS date parses the string as LOCAL
        # time and every age comes out short by the offset (negative, in fact).
        lp=$(date -j -u -f "%Y-%m-%dT%H:%M:%S" "${last:0:19}" +%s 2>/dev/null || echo "$NOW")
        last_age="last ping $(age $(( NOW - lp ))) ago"
    fi
    if [[ "$status" == "up" ]]; then
        printf "  up      %-34s %s\n" "$name" "$last_age"
    else
        red=$(( red + 1 ))
        since=$(grep -F "$name"$'\t' "$STATE" 2>/dev/null | head -1 | cut -f2)
        case "$since" in ''|*[!0-9]*) downfor="duration unknown (not yet tracked)" ;;
                         *) downfor="down $(age $(( NOW - since )))" ;; esac
        printf "  %-7s %-34s %s, %s\n" "$(echo "$status" | tr "[:lower:]" "[:upper:]")" "$name" "$downfor" "$last_age"
    fi
done < <(jq -r '.checks | sort_by(.status=="up", .name) | .[] | [.name, .status, (.last_ping//"null")] | @tsv' <<<"$API")
echo "  -> ${red} of ${total} not up"
echo

# ---- did the data protection actually run? --------------------------------
# A green check means the job ran, not that it did anything. These are the
# numbers that would have shown the 11-day gap on day one: the backup was
# "failing as usual" while silently skipping four phases.
echo "BACKUP REALITY CHECK"
lastlog=$(ls -t "$HOME/Library/Logs/tigris-backup"/*.log 2>/dev/null | head -1)
if [[ -n "$lastlog" ]]; then
    outcome=$(grep -E '^=== .*(DONE|ABORT)' "$lastlog" | tail -1 | sed -E 's/^=== [0-9-]+ [0-9:]+ //;s/ ===$//')
    st=$(grep -E '^=== ' "$lastlog" | head -1 | grep -oE '[0-9]{2}:[0-9]{2}:[0-9]{2}')
    en=$(grep -E '^=== .*(DONE|ABORT)' "$lastlog" | tail -1 | grep -oE '[0-9]{2}:[0-9]{2}:[0-9]{2}')
    phases=$(grep -oE "sync [a-z0-9]+:" "$lastlog" | sort -u | wc -l | tr -d ' ')
    skipped=$(grep -cE '^SKIP .*duration limit' "$lastlog" || true)
    echo "  tigris-backup  $(basename "$lastlog" .log): ${outcome:-NO COMPLETION LINE}"
    echo "                 ${st:-?} -> ${en:-?}, ${phases} phase(s) ran, ${skipped} skipped on deadline"
else
    echo "  tigris-backup  NO LOGS FOUND"
fi
mvlog=$(ls -t "$HOME/Library/Logs/msgvault-backup"/*.log 2>/dev/null | head -1)
[[ -n "$mvlog" ]] && echo "  msgvault       $(grep -oE 'added [^;]+' "$mvlog" | head -1 | sed 's/$//')  ($(basename "$mvlog" .log))"
snaps=$(ls "$EXT/msgvault-backup/snapshots" 2>/dev/null | wc -l | tr -d ' ')
echo "  repo           ${snaps} snapshot file(s) on $EXT"
# Weekly exact-verify pass: stale means nothing has proven the backup byte-exact.
rec=$(ls -t "$HOME/Library/Logs/tigris-backup-reconcile"/*.log 2>/dev/null | head -1)
if [[ -n "$rec" ]]; then
    recd=$(basename "$rec" | cut -c1-10)
    recs=$(date -j -f "%Y-%m-%d" "$recd" +%s 2>/dev/null || echo "$NOW")
    echo "  reconcile      last ran ${recd} ($(age $(( NOW - recs ))) ago) — the only exact size+mtime verification"
fi
echo

# ---- headroom -------------------------------------------------------------
echo "HEADROOM"
df -h /System/Volumes/Data "$EXT" 2>/dev/null | awk 'NR>1 && $1 ~ /disk/ {printf "  %-28s %s used of %s (%s free)\n", $NF, $3, $2, $4}'
echo

summary="${red} of ${total} checks not up"
echo "SUMMARY: $summary"

# --- delivery hook ---------------------------------------------------------
# A push transport (ntfy topic, msmtp) would go here. Left out on purpose; see
# the header. Repeating delivery is healthchecks.io's Email Reports setting.

[[ $DRY_RUN -eq 1 ]] && exit 0
# Empty first arg is the ping PATH (bare = success); passing --data-raw as $1
# would append it to the URL and 404 silently.
job_hc "" --data-raw "monitoring-digest $(date '+%F %T') ${summary}"
