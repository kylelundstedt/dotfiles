#!/usr/bin/env bash
# bump-vm-image — move the dev-VM image pin to the newest published build.
#
# WHY THIS EXISTS. The recreate cycle's whole justification is OS security
# patching: nothing on these VMs patches itself, apt-daily is masked, and
# exe.dev fixes the image at creation. But the pin in new-dev-vm is a literal
# string, and exeslim rebuilds WEEKLY on a cron to pick up Ubuntu updates. Left
# alone, a scheduled cycle would faithfully recreate every VM onto the same
# frozen userspace forever — looking like patching while pinning staleness.
#
# Deliberately NOT automatic. It prints the diff and needs --write, so a cycle
# never silently moves the fleet onto an image nobody looked at.
#
# Usage:
#   bump-vm-image            # report only
#   bump-vm-image --write    # update the pin
set -euo pipefail

REPO="kylelundstedt/exeslim-dev"
TARGET="$(dirname "$0")/new-dev-vm"
WRITE=false
[[ "${1:-}" == "--write" ]] && WRITE=true

current=$(grep -oE 'exeslim-dev:[0-9]{4}-[0-9]{2}-[0-9]{2}\.[0-9]+\.[0-9]+' "$TARGET" | head -1 | cut -d: -f2)
[[ -n "$current" ]] || { echo "bump-vm-image: no pin found in $TARGET" >&2; exit 1; }

tok=$(curl -fsS "https://ghcr.io/token?scope=repository:${REPO}:pull" 2>/dev/null | jq -r .token)
[[ -n "$tok" && "$tok" != null ]] || { echo "bump-vm-image: could not get a registry token" >&2; exit 1; }

# Immutable build ids only — :latest and :<date> move, :<sha> is reused by the
# scheduled rebuild. Sort numerically per component so .10 beats .9.
latest=$(curl -fsS -H "Authorization: Bearer $tok" \
    "https://ghcr.io/v2/${REPO}/tags/list" 2>/dev/null \
  | jq -r '.tags[]' \
  | grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}\.[0-9]+\.[0-9]+$' \
  | sort -t. -k1,1 -k2,2n -k3,3n | tail -1)
[[ -n "$latest" ]] || { echo "bump-vm-image: no build-id tags found" >&2; exit 1; }

echo "  current pin: $current"
echo "  latest build: $latest"

if [[ "$current" == "$latest" ]]; then
    echo "  up to date"
    exit 0
fi

# Never pin something that cannot be pulled. A tag can exist in the listing and
# still fail to resolve; check the manifest before writing it into the script
# that every future VM is built from.
code=$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $tok" \
  -H 'Accept: application/vnd.oci.image.manifest.v1+json,application/vnd.docker.distribution.manifest.v2+json' \
  "https://ghcr.io/v2/${REPO}/manifests/${latest}")
[[ "$code" == "200" ]] || { echo "bump-vm-image: $latest does not resolve (HTTP $code) — not pinning" >&2; exit 1; }
echo "  manifest verified (HTTP 200)"

if [[ "$WRITE" != true ]]; then
    echo ""
    echo "  would update the pin: $current -> $latest"
    echo "  re-run with --write to apply, then commit"
    exit 0
fi

sed -i '' "s#exeslim-dev:${current}#exeslim-dev:${latest}#" "$TARGET"
echo "  pinned $latest in $(basename "$TARGET")"
echo "  commit it, then any recreate builds on the new image"
