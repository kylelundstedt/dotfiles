#!/usr/bin/env bash
# retire-vm — retire a dev VM that has been replaced, in the right order.
#
# ORDER MATTERS. The collector entry comes out FIRST. Delete the VM first and
# the collector spends the gap scraping a host that no longer exists, which
# surfaces as a monitoring failure that looks like a real outage.
#
# Deletion is NOT the default and is never implied by a successful cleanup:
# pass --delete explicitly. Without it this does the reversible half (collector
# entry, with a timestamped backup) and prints the command for the rest.
#
# Usage:
#   retire-vm iv-ave-adapters                        # collector entry only
#   retire-vm iv-ave-adapters --replaced-by iv-ave-adapters-next
#   retire-vm iv-ave-adapters --delete               # ... and delete the VM
set -euo pipefail

COLLECTOR_CONF="$HOME/.agentsview/config.toml"
COLLECTOR_LABEL="gui/$(id -u)/com.kylelundstedt.agentsview"

OLD=""; REPLACED_BY=""; DELETE=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --replaced-by) REPLACED_BY="${2:?}"; shift 2 ;;
        --delete)      DELETE=true; shift ;;
        -h|--help)     sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*)            echo "unknown flag: $1" >&2; exit 1 ;;
        *)             OLD="$1"; shift ;;
    esac
done
[[ -n "$OLD" ]] || { echo "usage: retire-vm <old-vm> [--replaced-by <new>] [--delete]" >&2; exit 1; }

die() { echo "retire-vm: $*" >&2; exit 1; }

[[ "$(hostname -s)" == "klundstedt-mini" ]] \
    || die "control-plane mutations run from klundstedt-mini only (CLAUDE.md)"

# If a replacement is named, it must actually be healthy before we take anything
# away from the old one. A replacement that is merely *present* is not evidence.
if [[ -n "$REPLACED_BY" ]]; then
    echo "== checking replacement $REPLACED_BY"
    ssh -o ConnectTimeout=30 exe.dev ls --json 2>/dev/null \
        | jq -e --arg n "$REPLACED_BY" '.vms[] | select(.vm_name==$n and .status=="running")' >/dev/null \
        || die "$REPLACED_BY is not a running VM"
    ssh -o ConnectTimeout=30 "$REPLACED_BY" \
        'systemctl --user is-active agentsview-source.service >/dev/null 2>&1' \
        || die "$REPLACED_BY is not collecting (agentsview-source inactive) — not retiring $OLD"
    echo "  running, agentsview-source active"
fi

# Worktrees are invisible to the usual checks. `new-dev-vm --recreate` infers
# work repos with `[ -d .git ]`, but a git worktree's .git is a FILE, so a
# worktree checkout is never reproduced on the replacement — and `git status`
# on the parent repo says nothing about it. Found on iv-home 2026-07-29:
# ~/iv-home-dataset-mcp, a worktree on branch dataset-mcp.
#
# Warn rather than block: a pushed worktree costs one `git worktree add` to
# restore, but an unpushed one is real work about to be deleted.
# EVERY repo, not just worktrees, and not just depth 1. The first version of
# this checked `[ -f .git ]` — worktrees only — so an ordinary clone with
# unpushed commits was never examined at all. iv-docs had 3 unpushed commits
# (main +1, entire/checkpoints/v1 +2) in a plain ~/iv-docs, and the VM was one
# render-verification away from deletion.
#
# Depth 3 because work lives at ~/repo, ~/worktrees/<name>, and
# ~/github/<owner>/<repo>. `--branches HEAD --not --remotes` counts every local
# branch, not just the checked-out one — a stale side branch is still work.
echo "== repos on $OLD"
wt=$(ssh -o ConnectTimeout=60 "$OLD" 'for d in ~/*/ ~/*/*/ ~/*/*/*/; do
        [ -e "$d/.git" ] || continue
        b=$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null)
        u=$(git -C "$d" status --porcelain 2>/dev/null | wc -l | tr -d " ")
        p=$(git -C "$d" rev-list --count --branches HEAD --not --remotes 2>/dev/null)
        [ "$u" = 0 ] && [ "$p" = 0 ] && continue
        echo "$(echo "$d" | sed "s#$HOME/##; s#/\$##") branch=$b uncommitted=$u unpushed=$p"
     done' 2>/dev/null)
if [[ -n "$wt" ]]; then
    echo "$wt" | sed 's/^/  !! /'
    die "repo(s) above have uncommitted or unpushed work — push before retiring $OLD"
fi
echo "  all clean and pushed"

# UNGIT'D TREES: the question is not "does this have a .git" but "is this
# content already committed somewhere". iv-foundry-stage2's retirement was held
# most of a day on ~31 MB judged unique because no repo of that name existed on
# GitHub — while every source file was byte-identical to origin/iv-foundry-stage2
# on the iv-docs repo. A tree can be a stale working copy of a BRANCH of another
# repo, and three separate checks were silent about that.
#
# So: hash every non-generated file and ask whether any repo on this VM already
# has that blob. Zero misses means the tree is a duplicate of committed content
# and the VM is disposable regardless of what its directory layout suggests.
echo "== ungit'd trees on $OLD"
ung=$(ssh -o ConnectTimeout=60 "$OLD" 'bash -s' 2>/dev/null <<'REMOTE'
shopt -s nullglob
repos=()
for d in ~/*/ ~/*/*/; do [ -e "$d/.git" ] && repos+=("$d"); done
(( ${#repos[@]} )) || exit 0
# Depth 1 only for REPORTING (repo discovery above still scans deeper).
# Scanning deeper listed a tree and then each of its own subdirectories
# again - decisions/, drafts/, platform/ - all children of one ungit'd
# tree. Aggregating at the top level is both quieter and more accurate.
for d in ~/*/; do
    [ -d "$d" ] || continue
    [ -e "$d/.git" ] && continue
    # Inside a repo already? Then it is that repo's business. Walk the WHOLE
    # ancestor chain — checking only the immediate parent reported every
    # subdirectory of every repo (decisions/, drafts/, src/ ...) as ungit'd.
    p="${d%/}"; inrepo=""
    while [ "$p" != "$HOME" ] && [ "$p" != "/" ]; do
        p=$(dirname "$p")
        [ -e "$p/.git" ] && { inrepo=1; break; }
    done
    [ -n "$inrepo" ] && continue
    # Toolchain and runtime dirs are not work. NO `case` here: bash 3.2 counts
    # parens naively inside $( ), so a case pattern's unbalanced `)` closes the
    # command substitution early and the whole script fails to parse.
    b=$(basename "${d%/}")
    skip=""
    for s in node go bin lib include share; do [ "$b" = "$s" ] && skip=1; done
    [ -n "$skip" ] && continue
    files=$(find "$d" -type f \
        -not -path '*/.git/*' -not -path '*/_site*' -not -path '*/.quarto/*' \
        -not -path '*/__pycache__/*' -not -path '*/.venv/*' \
        -not -path '*/node_modules/*' -not -path '*/.pytest_cache/*' 2>/dev/null | head -5000)
    n=$(wc -l <<<"$files" | tr -d ' '); [ "$n" = 0 ] && continue
    miss=0
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        h=$(git hash-object "$f" 2>/dev/null) || { miss=$((miss+1)); continue; }
        found=0
        for r in "${repos[@]}"; do
            git -C "$r" cat-file -e "$h" 2>/dev/null && { found=1; break; }
        done
        [ "$found" = 0 ] && miss=$((miss+1))
    done <<<"$files"
    echo "$(basename "${d%/}")|$n|$miss"
done
REMOTE
)
if [[ -z "$ung" ]]; then
    echo "  none"
else
    while IFS='|' read -r name n miss; do
        [[ -z "$name" ]] && continue
        if [[ "$miss" == "0" ]]; then
            echo "  $name: $n files, all already committed in a repo on this VM — disposable"
        else
            echo "  ?  $name: $miss of $n files not in any LOCAL repo (check the remote)"
        fi
    done <<<"$ung"
    # ADVISORY, not a gate. This searches only the repos cloned on this VM, so
    # it proves the positive case and NOT the negative: a file whose blob lives
    # only on the remote reads as "not found" here. iv-foundry-stage2's 29 MB
    # was exactly that — every file was on origin/iv-foundry-stage2 of the
    # iv-docs repo, a branch nothing local had checked out.
    #
    # So "all already committed" means genuinely disposable; a non-zero count
    # means LOOK, not STOP — hash the tree against the remote branches of the
    # sibling repos before concluding anything. Blocking on this count would
    # have held four VMs that were fine.
    echo "  (advisory: local repos only — a non-zero count needs a remote check, not a halt)"
fi

echo "== collector entry for $OLD"
if grep -q "host = \"$OLD\"" "$COLLECTOR_CONF" 2>/dev/null; then
    cp "$COLLECTOR_CONF" "$COLLECTOR_CONF.bak-$(date +%Y%m%d%H%M%S)"
    python3 - "$COLLECTOR_CONF" "$OLD" <<'PY'
import sys, pathlib, re
conf, name = sys.argv[1:3]
p = pathlib.Path(conf); s = p.read_text()
parts = re.split(r'(?m)^\[\[remote_hosts\]\]\s*$', s)
head, blocks = parts[0], parts[1:]
kept = [b for b in blocks if f'host = "{name}"' not in b]
if len(kept) == len(blocks):
    sys.exit(f"no [[remote_hosts]] block for {name}")
out = head.rstrip("\n") + "\n" + "".join("\n[[remote_hosts]]" + b.rstrip("\n") + "\n" for b in kept)
p.write_text(out)
print(f"  removed {len(blocks)-len(kept)} block(s); {len(kept)} remain")
PY
    python3 -c "import tomllib,sys; tomllib.load(open('$COLLECTOR_CONF','rb'))" \
        || die "collector config is no longer valid TOML — restore the .bak beside it"
    launchctl kickstart -k "$COLLECTOR_LABEL" >/dev/null 2>&1 || true
    echo "  collector restarted"
else
    echo "  none found (already removed, or never enrolled)"
fi

if [[ "$DELETE" == true ]]; then
    echo "== deleting $OLD"
    ssh -o ConnectTimeout=30 exe.dev rm "$OLD"
    echo "  deleted"

    # RESTORE THE CANONICAL NAME. Without this the fleet accretes suffixes —
    # the next cycle would produce iv-gitlake-next-next — and anything pinned to
    # a hostname drifts every round. Only fires when the replacement is exactly
    # <old>-next, so it can never rename something unrelated.
    if [[ -n "$REPLACED_BY" && "$REPLACED_BY" == "$OLD-next" ]]; then
        echo "== restoring canonical name: $REPLACED_BY -> $OLD"
        ssh -o ConnectTimeout=30 exe.dev rename "$REPLACED_BY" "$OLD" >/dev/null \
            || die "rename failed; VM is still $REPLACED_BY"
        echo "  exe.dev: renamed"

        # The exe.dev rename does NOT touch the OS or Tailscale hostname, and
        # the collector URL embeds the tailnet name — so all three move together
        # or the VM silently stops being scraped.
        #
        # `tailscale set --hostname` is NOT enough: Tailscale keeps the device
        # name assigned at registration, so the node stays <name>-1 even after
        # the stale node is gone and tailscaled restarts. Measured on
        # iv-ave-adapters, 2026-07-29. The node must re-register, which for
        # these ephemeral nodes means logout + join-tailnet — and join-tailnet
        # now clears any node still holding the name first.
        #
        # Over the *.exe.xyz edge deliberately: `tailscale logout` would cut a
        # tailnet SSH mid-command.
        ssh -o ConnectTimeout=60 -o StrictHostKeyChecking=accept-new "$OLD.exe.xyz" "bash -lc '
            sudo hostnamectl set-hostname $OLD
            sudo tailscale logout'" >/dev/null 2>&1 \
            || echo "  [!] could not reset hostname on the VM"
        if "$HOME/.agents/skills/join-tailnet/join-tailnet.sh" "$OLD" >/dev/null 2>&1; then
            echo "  VM: re-registered on the tailnet as $OLD"
        else
            echo "  [!] tailnet re-join failed — the VM is off the tailnet; run join-tailnet manually"
        fi

        cp "$COLLECTOR_CONF" "$COLLECTOR_CONF.bak-$(date +%Y%m%d%H%M%S)"
        python3 - "$COLLECTOR_CONF" "$REPLACED_BY" "$OLD" <<'PY'
import sys, pathlib
conf, old_name, new_name = sys.argv[1:4]
p = pathlib.Path(conf); s = p.read_text()
if f'host = "{old_name}"' not in s:
    sys.exit(f"  collector: no entry for {old_name} to rename")
s = s.replace(f'host = "{old_name}"', f'host = "{new_name}"')
s = s.replace(f'http://{old_name}.', f'http://{new_name}.')
p.write_text(s)
print(f"  collector: {old_name} -> {new_name}")
PY
        python3 -c "import tomllib; tomllib.load(open('$COLLECTOR_CONF','rb'))" \
            || die "collector config is no longer valid TOML — restore the .bak beside it"
        launchctl kickstart -k "$COLLECTOR_LABEL" >/dev/null 2>&1 || true
        echo "  collector restarted"
    fi
else
    echo ""
    echo "NOT deleted. Confirm nothing external depends on the name — custom"
    echo "domains, webhooks, anything pinned to its tailnet hostname — then:"
    echo "  retire-vm $OLD --delete"
fi
