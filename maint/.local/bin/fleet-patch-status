#!/usr/bin/env bash
# fleet-patch-status — is in-place OS patching actually happening?
#
# Deliberately ON DEMAND, not scheduled. The point of moving from scheduled
# recreates to in-place patching was to stop betting on unattended machinery;
# adding an unattended watcher over it would be the same bet one level up.
#
# But an unattended patcher with no visibility is exactly the failure this fleet
# kept producing — a timer that silently stops, or a VM whose apt sources broke,
# looks identical to a healthy one. Run this when you want to know.
#
# Reports per VM: pending upgrades, how many are security, and the timer's last
# result and next run. A VM missing the timer entirely is the interesting case:
# it predates the change or its provision-iv.sh run failed.
set -uo pipefail

VMS=$(ssh -n -o ConnectTimeout=30 exe.dev ls --json 2>/dev/null \
      | jq -r '.vms[] | select((.tags//[]) | index("mcp-agent")) | .vm_name' | sort)
[[ -n "$VMS" ]] || { echo "fleet-patch-status: could not list VMs" >&2; exit 1; }

printf "%-26s %8s %9s %-10s %s\n" VM PENDING SECURITY RESULT "NEXT RUN"
stale=0
for vm in $VMS; do
    out=$(ssh -n -o ConnectTimeout=45 "$vm" 'bash -lc "
        sudo apt-get update -qq >/dev/null 2>&1
        p=\$(apt list --upgradable 2>/dev/null | grep -c upgradable)
        s=\$(apt list --upgradable 2>/dev/null | grep -ci security)
        # A oneshot that has NEVER run also reports Result=success, so ask when
        # it last actually executed before believing that.
        t=\$(systemctl show iv-apt-upgrade.service -p ExecMainStartTimestamp --value 2>/dev/null)
        if [ -z \"\$t\" ]; then r=never
        else r=\$(systemctl show iv-apt-upgrade.service -p Result --value 2>/dev/null); fi
        n=\$(systemctl list-timers iv-apt-upgrade.timer --no-legend 2>/dev/null | awk \"{print \\\$1\\\"-\\\"\\\$2}\")
        echo \"\$p|\$s|\${r:-NO-UNIT}|\${n:-none}\"
    "' 2>/dev/null | tail -1)
    IFS='|' read -r p s r n <<<"${out:-||UNREACHABLE|}"
    printf "%-26s %8s %9s %-10s %s\n" "$vm" "${p:-?}" "${s:-?}" "${r:-?}" "${n:-?}"
    # Security updates outstanding, no timer, or a failed run all mean the
    # patching is not doing its job on that box.
    { [[ "${s:-0}" != 0 ]] || [[ "${r:-}" != success ]]; } && stale=$((stale+1))  # "never" counts as needing attention
done

echo ""
if (( stale )); then
    echo "$stale VM(s) need attention — security updates outstanding, timer missing, or last run not successful."
    echo "Force one now:  ssh <vm> sudo systemctl start iv-apt-upgrade.service"
    exit 1
fi
echo "all VMs patched and their timers healthy"
