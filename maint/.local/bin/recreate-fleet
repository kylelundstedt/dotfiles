#!/usr/bin/env bash
# recreate-fleet — drive the dev-VM recreates SEQUENTIALLY, one at a time.
#
# TRANSITIONAL. Delete once every VM has been migrated to exeslim-dev and the
# old integration names are gone (see new-dev-vm's migration map).
#
# WHY SEQUENTIAL, and not one agent per VM:
#
#   1. exe.dev drops TCP SYNs per SOURCE IP. Every recreate opens many
#      *.exe.xyz connections from this one Mac; running six at once reliably
#      trips a minutes-long lockout whose symptom is a hang, not an error.
#      This is a standing rule in CLAUDE.md, not a guess — it was tripped once
#      on 2026-07-29 just from debugging.
#
#   2. new-dev-vm phase 5 does a read-modify-write on the AgentsView collector
#      config with no locking: read the whole TOML, append a [[remote_hosts]]
#      block, write it back. Concurrent runs silently drop each other's
#      entries, and the symptom is a VM that looks fully enrolled while the
#      collector never scrapes it — precisely the fail-closed guarantee the
#      monitoring exists to provide.
#
#   3. Every cutover so far has surfaced a real bug (a work repo that was never
#      cloned; a doc-site VM with no renderer). Six in flight means six
#      half-built VMs when the seventh bug lands.
#
# NOTHING IS EVER DELETED — by design, not by omission. This builds and
# verifies replacements; cutover is a human act. See the summary block at the
# end for why an unattended cutover would be wrong here.
#
# Usage:
#   recreate-fleet                      # default queue, checkpoint after 2
#   recreate-fleet --checkpoint 0       # no checkpoint, run the whole queue
#   recreate-fleet --dry-run
#   recreate-fleet iv-docs              # just these
set -uo pipefail   # deliberately NOT -e: a failure must be caught and reported,
                   # not abort mid-VM leaving no summary

# The queue is DERIVED, not literal. A hard-coded list goes stale the moment it
# runs: the original one still named five VMs that had already migrated, included
# one deliberately excluded, and omitted another entirely. A VM is due when its
# image is not the current pin, or when it is older than --max-age days —
# whichever comes first, since the cycle exists for OS patching.
QUEUE=()
MAX_AGE=30
EXCLUDE_FILE="$(dirname "$0")/../../../provisioning/recreate-exclude.txt"
CHECKPOINT=2
DRY=false
PREFLIGHT=false
NEWVM="$(dirname "$0")/new-dev-vm"

explicit=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --checkpoint) CHECKPOINT="${2:?}"; shift 2 ;;
        --dry-run)    DRY=true; shift ;;
        --preflight)  PREFLIGHT=true; shift ;;
        --max-age)    MAX_AGE="${2:?}"; shift 2 ;;
        -h|--help)    sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*)           echo "unknown flag: $1" >&2; exit 1 ;;
        *)            explicit+=("$1"); shift ;;
    esac
done
if (( ${#explicit[@]} )); then
    # An explicit name overrides both the due-check and the exclusion list: the
    # operator asked for this VM by name.
    QUEUE=("${explicit[@]}")
    DERIVED=false
else
    DERIVED=true
fi

[[ -x "$NEWVM" ]] || { echo "new-dev-vm not found next to this script" >&2; exit 1; }

# SKIP, don't fail, when the agent cannot sign. 1Password locks on its own, and
# every control-plane call needs the exe.dev key — so an unattended run finds
# the whole queue unrunnable through no fault of its own. Exiting 0 keeps that
# out of the failure channel; exiting non-zero would page for something that is
# just "the Mac locked". new-dev-vm still refuses individually, so a lock that
# happens mid-run is caught there.
#
# The agent LISTS the key while locked, so `ssh-add -l` proves nothing — only an
# actual signature does.
if ! ssh-add -T "$HOME/.ssh/exe_dev.pub" >/dev/null 2>&1; then
    echo "recreate-fleet: 1Password agent cannot sign with the exe.dev key — skipping this run."
    echo "  (unlock 1Password on klundstedt-mini; nothing was started)"
    exit 0
fi

# --- derive the queue -------------------------------------------------------
if [[ "$DERIVED" == true ]]; then
    PIN=$(grep -oE 'exeslim-dev:[0-9]{4}-[0-9]{2}-[0-9]{2}\.[0-9]+\.[0-9]+' "$NEWVM" | head -1 | cut -d: -f2)
    [[ -n "$PIN" ]] || { echo "recreate-fleet: cannot read the image pin from new-dev-vm" >&2; exit 1; }

    excl=""
    [[ -f "$EXCLUDE_FILE" ]] && excl=$(grep -vE '^\s*#|^\s*$' "$EXCLUDE_FILE" | tr '\n' ' ')

    all_vms=$(ssh -o ConnectTimeout=30 exe.dev ls --json 2>/dev/null | jq -r '.vms[].vm_name')
    echo "== deriving queue (pin=$PIN, max-age=${MAX_AGE}d)"
    # `last_active_at` is not creation; `created_at` is what ages. Compare in
    # UTC epoch seconds so timezone never enters into it.
    now=$(date -u +%s)
    while IFS='|' read -r vm img created; do
        [[ -z "$vm" ]] && continue
        case " $excl " in *" $vm "*) echo "  - $vm (excluded)"; continue ;; esac
        # A replacement awaiting cutover is not a steady-state VM. Without this
        # an aged iv-foo-next would be "recreated" as iv-foo-next-next, and the
        # suffix would accrete every cycle. Demonstrated by the first dry run.
        case "$vm" in *-next) echo "  - $vm (pending cutover)"; continue ;; esac
        # Nor is a VM that already has one built and waiting — building a second
        # replacement helps nobody and consumes the pool.
        if grep -qx "$vm-next" <<<"$all_vms"; then
            echo "  - $vm (replacement $vm-next already built, awaiting cutover)"; continue
        fi
        age_days=$(( (now - $(date -u -j -f "%Y-%m-%dT%H:%M:%SZ" "$created" +%s 2>/dev/null || echo "$now")) / 86400 ))
        why=""
        [[ "$img" != *"$PIN" ]] && why="image $img != pin"
        (( age_days >= MAX_AGE )) && why="${why:+$why; }age ${age_days}d >= ${MAX_AGE}d"
        if [[ -n "$why" ]]; then
            QUEUE+=("$vm"); echo "  + $vm ($why)"
        else
            echo "  . $vm (current, ${age_days}d old)"
        fi
    done < <(ssh -o ConnectTimeout=30 exe.dev ls --json 2>/dev/null \
        | jq -r '.vms[] | select((.tags//[]) | index("mcp-agent")) | "\(.vm_name)|\(.image)|\(.created_at)"')

    if (( ${#QUEUE[@]} == 0 )); then
        echo "== nothing due"
        exit 0
    fi
fi

# --- preflight ---------------------------------------------------------------
# Every blocker this migration hit was discoverable READ-ONLY before anything
# was built: unpushed commits on iv-docs, an unpopulated tag:notion, a missing
# repo-<x>-rw, work living under ~/worktrees where nothing looked. Each one
# instead surfaced mid-run, after a VM was already provisioned.
#
# This audits the whole queue and prints one report. Nothing is created,
# nothing is deleted, no integration is attached.
if [[ "$PREFLIGHT" == true ]]; then
    echo "== preflight audit (read-only) — $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    blockers=0
    for vm in "${QUEUE[@]}"; do
        echo ""
        echo "--- $vm"
        if ! ssh -o ConnectTimeout=30 exe.dev ls --json 2>/dev/null \
             | jq -e --arg n "$vm" '.vms[] | select(.vm_name==$n)' >/dev/null; then
            echo "  !! not a running VM"; blockers=$((blockers+1)); continue
        fi

        # 1. Unpushed work — the thing that nearly cost iv-docs 3 commits.
        #    Fetch first: a stale remote-tracking ref over-reports, which is how
        #    entire/checkpoints/v1 looked like 2 unpushed commits when it had none.
        dirty=$(ssh -o ConnectTimeout=60 "$vm" 'for d in ~/*/ ~/*/*/ ~/*/*/*/; do
                    [ -e "$d/.git" ] || continue
                    git -C "$d" fetch -q --all --prune 2>/dev/null
                    u=$(git -C "$d" status --porcelain 2>/dev/null | wc -l | tr -d " ")
                    p=$(git -C "$d" rev-list --count --branches HEAD --not --remotes 2>/dev/null)
                    [ "$u" = 0 ] && [ "$p" = 0 ] && continue
                    echo "$(echo "$d" | sed "s#$HOME/##; s#/\$##") uncommitted=$u unpushed=$p"
                done' 2>/dev/null)
        if [[ -n "$dirty" ]]; then
            echo "$dirty" | sed 's/^/  !! /'; blockers=$((blockers+1))
        else
            echo "  repos: clean and pushed"
        fi

        # 2. What the recreate itself would refuse on — missing renamed
        #    integrations, or a renamed tag granting less than the original.
        out=$("$NEWVM" --name "$vm-next" --recreate "$vm" --dry-run 2>&1)
        if grep -qE 'integrations (add|attach)' <<<"$out"; then
            grep -oE 'ssh exe\.dev integrations (add|attach) [^"]*' <<<"$out" \
                | sed 's/^/  prep: /'
            blockers=$((blockers+1))
        else
            echo "  prep: none needed"
        fi
        grep -E '^  [+-~] repo' <<<"$out" | sed 's/^/  /'
    done
    echo ""
    if (( blockers )); then
        echo "== $blockers VM(s) need attention before recreating"
        exit 1
    fi
    echo "== all clear"
    exit 0
fi

LOGDIR="$HOME/.local/state/recreate-fleet"
mkdir -p "$LOGDIR"
LOG="$LOGDIR/$(date -u +%Y%m%dT%H%M%SZ).log"
echo "log: $LOG"

say() { printf '\n\033[1m%s\033[0m\n' "$*" | tee -a "$LOG"; }
note() { printf '%s\n' "$*" | tee -a "$LOG"; }

done_vms=(); failed_vm=""

for vm in "${QUEUE[@]}"; do
    if (( CHECKPOINT > 0 )) && (( ${#done_vms[@]} >= CHECKPOINT )); then
        say "CHECKPOINT after ${#done_vms[@]}: ${done_vms[*]}"
        remaining=""
        for q in "${QUEUE[@]}"; do
            skip=""
            for d in ${done_vms[@]+"${done_vms[@]}"}; do [[ "$q" == "$d" ]] && skip=1; done
            [[ -z "$skip" ]] && remaining+="$q "
        done
        note "  remaining: $remaining"
        note "  resume with: recreate-fleet --checkpoint 0 $remaining"
        break
    fi

    new="$vm-next"
    say "=== $vm -> $new"

    # 1. Discover prep. new-dev-vm refuses (and prints the exact commands) when
    #    a renamed integration is missing or a renamed tag would grant less than
    #    the original. Both refusals are the point — they are failures that are
    #    silent otherwise.
    # LOOP the prep. new-dev-vm refuses in STAGES — it reports a renamed tag
    # that grants too little, and only once that is fixed does it report a
    # missing renamed integration. So one prep round can never satisfy a VM
    # that has both, which is exactly what iv-home hit: the tag attach
    # succeeded, the re-check surfaced the next refusal, and the queue stopped
    # having built nothing. Iterate until the dry-run is clean, or until a
    # round produces no new commands (which means the refusal is something we
    # cannot fix automatically).
    prep_round=0
    while :; do
        prep_out=$("$NEWVM" --name "$new" --recreate "$vm" --dry-run 2>&1)

        # No mapfile: macOS ships bash 3.2, where it does not exist. Same reason
        # the summary below indexes from the front rather than using ${a[-1]}.
        prep_cmds=()
        while IFS= read -r c; do
            [[ -n "$c" ]] && prep_cmds+=("$c")
        done < <(grep -oE 'ssh exe\.dev integrations (add|attach) [^"]*' <<<"$prep_out")

        if (( ${#prep_cmds[@]} == 0 )); then
            if grep -qE '^new-dev-vm:|!!' <<<"$prep_out"; then
                note "  refused, and no prep command was offered:"
                grep -E '!!|^new-dev-vm:' <<<"$prep_out" | sed 's/^/    /' | tee -a "$LOG"
                failed_vm="$vm"
            else
                (( prep_round == 0 )) && note "  prep: none needed"
            fi
            break
        fi

        prep_round=$((prep_round+1))
        if (( prep_round > 4 )); then
            note "  prep did not converge after 4 rounds — stopping"
            failed_vm="$vm"; break
        fi

        note "  prep round $prep_round (${#prep_cmds[@]} command(s)):"
        for c in "${prep_cmds[@]}"; do
            note "    $c"
            if [[ "$DRY" == true ]]; then continue; fi
            if ! out=$(bash -c "$c" 2>&1); then
                note "    FAILED: $out"; failed_vm="$vm"; break
            fi
            note "    -> ${out##*$'\n'}"
        done
        [[ -n "$failed_vm" ]] && break
        [[ "$DRY" == true ]] && break   # dry-run: report round 1 and move on
    done
    [[ -n "$failed_vm" ]] && break

    if [[ "$DRY" == true ]]; then
        note "  [dry-run] would recreate $vm as $new"
        done_vms+=("$vm"); continue
    fi

    # 2. The recreate itself.
    if "$NEWVM" --name "$new" --recreate "$vm" 2>&1 | tee -a "$LOG"; then
        note "  OK: $new built (old $vm untouched)"
        done_vms+=("$vm")
    else
        note "  FAILED during recreate of $vm — stopping. $new may exist and is left in place."
        failed_vm="$vm"; break
    fi
done

say "=== summary"
note "  completed: ${done_vms[*]:-none}"
[[ -n "$failed_vm" ]] && note "  FAILED at: $failed_vm (queue stopped; nothing deleted)"
note "  log: $LOG"
note ""
# THE UNATTENDED BOUNDARY, stated rather than implied. This tool BUILDS
# replacements and never cuts over. That is not an oversight to be closed later:
#
#   - retire-vm refuses on any uncommitted or unpushed work, and normal agent
#     activity produces untracked files (a rendered index-gfm.md blocked exactly
#     this on 2026-07-30). An unattended cutover would either stall on that or,
#     worse, be "fixed" by relaxing the check that protects real work.
#   - Nothing here verifies the VM still does its JOB. Units, disk and
#     control-plane denial are checked; whether the site still renders the same
#     bytes was verified by hand each time.
#   - Deletion is irreversible and the old VM is the only rollback.
#
# So what a schedule should run is a fleet REFRESH PROPOSAL: replacements built
# and verified, cutover left to a human. Retire with the command below.
note "  Built, NOT cut over. Each old VM is still running and serving."
if (( ${#done_vms[@]} )); then
    note ""
    note "  Verify each replacement (render its site if it serves one), then:"
    for d in ${done_vms[@]+"${done_vms[@]}"}; do
        note "    retire-vm $d --replaced-by $d-next --delete"
    done
    note ""
    note "  retire-vm refuses if any repo on the old VM has uncommitted or"
    note "  unpushed work, removes the collector entry before deleting, and"
    note "  restores the canonical name (exe.dev rename + OS/Tailscale hostname"
    note "  + collector URL + integration attachments, which do NOT follow a"
    note "  rename on their own)."
fi

[[ -n "$failed_vm" ]] && exit 1
exit 0
