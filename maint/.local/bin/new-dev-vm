#!/usr/bin/env bash
# new-dev-vm — create an exe.dev dev VM and enroll it in every fleet service.
#
# Recreating a VM is the ONLY way to change its base image (exe.dev fixes the
# image at creation; `cp` clones the disk you already have) and the only way a
# long-lived VM gets OS security patches — nothing on these boxes patches
# itself, apt-daily is masked, and `iv-docs` was measured at 77 pending security
# updates on a 43-day-old VM. So recreate is not an exceptional operation, it is
# the maintenance model. This script exists to make it cheap enough to actually
# do on a cycle.
#
# The disposability invariant this rests on is tested, not assumed: git and
# Tigris hold all permanent state, verified fleet-wide including /tmp
# (agent_docs/vm-disposability.md).
#
# What makes recreate expensive is NOT losing data — it is re-enrollment:
# tailnet, the AgentsView source token AND the matching collector entry,
# integrations, and the fail-closed monitors that page when a VM is missing.
# Every one of those is automated here.
#
# Deliberately NOT automated: deleting the old VM. That stays a separate,
# explicit human decision — see `--retire` for the checklist it prints.
#
# Usage:
#   new-dev-vm --name iv-foo --repo kylelundstedt/foo
#   new-dev-vm --name iv-foo --recreate iv-foo-old
#   new-dev-vm --name iv-foo --dry-run
#
# --recreate copies the source VM's tags and directly-attached integrations to
# the replacement, and prints what it will also inherit via tag: and auto:all.
# --no-inherit builds a bare VM instead, for deliberately narrowing a VM that
# has accumulated capabilities it no longer needs.
set -euo pipefail

# --- defaults ---------------------------------------------------------------
IMAGE_DEFAULT="ghcr.io/kylelundstedt/exeslim-dev:2026-08-19.13.1"
DISK=15GB
CPU=2
MEM=8GB
IV_PIN="2.9.0"       # tested immutable iv-image release; override with --iv-pin
COLLECTOR_CONF="$HOME/.agentsview/config.toml"
COLLECTOR_LABEL="gui/$(id -u)/com.kylelundstedt.agentsview"
TAILNET_DOMAIN="dojo-sun.ts.net"

NAME=""; IMAGE="$IMAGE_DEFAULT"; REPOS=(); TAGS=(); INTEGRATIONS=(); CHECKOUTS=()
RECREATE=""; DRY=false; SKIP_OVERLAY=false; INHERIT=true; RESUME_FROM=""

die() { echo "new-dev-vm: $*" >&2; exit 1; }

# --- resume ------------------------------------------------------------------
# A run that dies in phase 4 used to mean deleting a fully provisioned VM and
# starting over: ~20 minutes and a fresh 2 GB build, discarded. iv-docs was
# built THREE times that way. Transient failures are normal here — exe.dev's
# integration plumbing is eventually consistent on first use, so a 403 from
# tailscale-api or a 404 from the github proxy is expected, not exceptional.
#
# Phases are ordinal; --resume-from skips everything before the named one and
# continues against the VM that already exists.
phase_num() {
    case "$1" in
        create)     echo 1 ;;
        team)       echo 2 ;;
        overlay)    echo 3 ;;
        repos)      echo 4 ;;
        tailnet)    echo 5 ;;
        agentsview) echo 6 ;;
        verify)     echo 7 ;;
        *)          echo 0 ;;
    esac
}
PHASES="create team overlay repos tailnet agentsview verify"
START=1
should_run() { local n; n=$(phase_num "$1"); (( n >= START )); }
skipped()    { echo "  (skipped — resuming from $RESUME_FROM)"; }

# --- integration/tag migration map (TRANSITIONAL) ---------------------------
# Delete this block once every VM has been recreated and the old names are gone.
#
# The convention it migrates to:
#   integration = <kind>-<target>-<access>   kind = repo|bucket|api|svc
#                                            access always marked (ro|rw), never
#                                            a silent default
#   tag         = a CAPABILITY BUNDLE, never an owner. `tag:mcp-agent` says
#                 "runs our agent stack, needs the MotherDuck and GitHub Copilot
#                 proxies". Reading a VM's tags tells you what it may reach.
#
# Renaming in place would break the `~/iv-image` remote on every live VM (a
# per-integration proxy host is baked into the clone URL), so instead each VM
# picks up the new names when it is recreated. Old and new coexist until the
# last VM migrates.
map_tag() {
    case "$1" in
        iv)                         echo mcp-agent ;;
        notion-api)                 echo notion ;;
        kylelundstedt-fannie-sflpd) echo fannie-sflpd ;;
        motherduck-api|llm)         echo "" ;;   # dropped — see why_tag
        *)                          echo "$1" ;;
    esac
}
why_tag() {
    case "$1" in
        motherduck-api) echo "dead — no integration is attached to this tag" ;;
        llm)            echo "redundant — the llm integration is auto:all" ;;
        *)              echo "unused" ;;
    esac
}
map_int() {
    case "$1" in
        github-kylelundstedt-iv-image)   echo "" ;;   # dropped — see why_int
        github-kylelundstedt-dotfiles)   echo "" ;;   # dropped — see why_int
        github-kylelundstedt-iv-docs)    echo repo-iv-docs-rw ;;
        # DELIBERATE: this stays -rw on iv-docs as well as iv-ave-adapters.
        # Docs work edits and commits ave-adapters directly from iv-docs, so
        # read-only there would be routed around (ssh to the other box, or
        # re-attach -rw when inconvenient) — and a control that gets routed
        # around is worse than none, because the attachment list then
        # misrepresents the real authority. Confirmed with Kyle 2026-07-29.
        github-kylelundstedt-ave-adapters) echo repo-ave-adapters-rw ;;
        ave-adapters-ro)                 echo repo-ave-adapters-ro ;;
        github-kylelundstedt-gitlake)    echo repo-gitlake-rw ;;
        github-kylelundstedt-gitlake-examples) echo repo-gitlake-examples-rw ;;
        github-kylelundstedt-thoughts)   echo repo-thoughts-rw ;;
        github-kylelundstedt-iv-home)    echo repo-iv-home-rw ;;
        github-kylelundstedt-entire-agent-shelley) echo repo-entire-agent-shelley-rw ;;
        kylelundstedt-fannie-sflpd)      echo repo-fannie-sflpd-rw ;;
        # NOT renamed here. s3/http-proxy/catalog integrations hold real
        # credentials, so the migration for them is `integrations rename`, which
        # preserves the secret — not create-new-and-attach, which would mean
        # re-entering it. They keep their old names until every VM is migrated,
        # then get renamed in one pass:
        #   gitlake-examples               -> bucket-gitlake-examples
        #   iv-foundry-stage2-fannie-sflpd -> bucket-fannie-sflpd
        #   fannie-token                   -> api-fannie-sso
        #   telnyx-test                    -> svc-telnyx
        #   motherduck-mcp/github-mcp-home/tailscale-api/notion-api/motherduck-api
        #     -> api-* (these are hostname-coupled: the name IS
        #        <name>.int.exe.xyz, so mcp.manifest, install.sh and
        #        join-tailnet.sh change with them)
        *)                               echo "$1" ;;
    esac
}
why_int() {
    case "$1" in
        github-kylelundstedt-dotfiles|github-kylelundstedt-iv-image)
            echo "PUBLIC repo — clones over github.com, needs no credential" ;;
        *)  echo "unused" ;;
    esac
}
step() { printf '\n== %s\n' "$*"; }
run() { if [[ "$DRY" == true ]]; then echo "  [dry-run] $*"; else "$@"; fi; }

usage() {
    sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --name) NAME="${2:?}"; shift 2 ;;
        --image) IMAGE="${2:?}"; shift 2 ;;
        --disk) DISK="${2:?}"; shift 2 ;;
        --cpu) CPU="${2:?}"; shift 2 ;;
        --memory) MEM="${2:?}"; shift 2 ;;
        --iv-pin) IV_PIN="${2:?}"; shift 2 ;;
        --repo) REPOS+=("${2:?}"); shift 2 ;;
        --tag) TAGS+=("${2:?}"); shift 2 ;;
        --integration) INTEGRATIONS+=("${2:?}"); shift 2 ;;
        --recreate) RECREATE="${2:?}"; shift 2 ;;
        --no-inherit) INHERIT=false; shift ;;
        --resume-from) RESUME_FROM="${2:?}"; shift 2 ;;
        --skip-overlay) SKIP_OVERLAY=true; shift ;;
        --dry-run) DRY=true; shift ;;
        -h|--help) usage ;;
        *) die "unknown argument: $1" ;;
    esac
done

[[ -n "$NAME" ]] || die "--name is required"
# exe.dev rejects names ending in -<digits> (test-123 fails, test-abc works).
[[ "$NAME" =~ -[0-9]+$ ]] && die "exe.dev rejects names ending in -<digits>: $NAME"

if [[ -n "$RESUME_FROM" ]]; then
    START=$(phase_num "$RESUME_FROM")
    (( START == 0 )) && die "unknown phase '$RESUME_FROM' (one of: $PHASES)"
fi

# --- phase 0: preflight -----------------------------------------------------
step "preflight"

[[ "$(hostname -s)" == "klundstedt-mini" ]] || \
    die "control-plane mutations run from klundstedt-mini only (CLAUDE.md)"

for t in ssh jq tailscale python3; do
    command -v "$t" >/dev/null || die "$t not on PATH"
done
[[ -f "$COLLECTOR_CONF" ]] || die "AgentsView collector config missing: $COLLECTOR_CONF"

# exe.dev auth fails silently-ish when 1Password is locked: the agent still
# LISTS the key but cannot sign with it. `ssh-add -l` therefore proves nothing;
# only an actual signature does. Cost of skipping this check: the script dies
# halfway through, after creating a VM.
if ! ssh-add -T "$HOME/.ssh/exe_dev.pub" >/dev/null 2>&1; then
    die "1Password agent cannot sign with exe_dev key — unlock 1Password and retry"
fi
ssh -o ConnectTimeout=30 exe.dev whoami >/dev/null 2>&1 \
    || die "cannot authenticate to exe.dev"
echo "  control plane: ok"

vm_exists=false
if ssh -o ConnectTimeout=30 exe.dev ls --json 2>/dev/null | jq -e --arg n "$NAME" \
        '.vms[] | select(.vm_name==$n)' >/dev/null; then
    vm_exists=true
fi
# Resuming REQUIRES the VM; creating requires its absence.
if [[ -n "$RESUME_FROM" ]]; then
    [[ "$vm_exists" == true ]] || die "--resume-from needs an existing VM: $NAME"
    echo "  resuming $NAME from phase '$RESUME_FROM'"
elif [[ "$vm_exists" == true ]]; then
    die "VM already exists: $NAME"
fi

if [[ -n "$RECREATE" ]]; then
    ssh -o ConnectTimeout=30 exe.dev ls --json 2>/dev/null | jq -e --arg n "$RECREATE" \
        '.vms[] | select(.vm_name==$n)' >/dev/null \
        || die "--recreate target does not exist: $RECREATE"
    echo "  recreate source: $RECREATE (will NOT be deleted by this script)"

    # CARRY THE CAPABILITY SET FORWARD. Until 2026-07-29 this block only checked
    # that the source existed — the replacement was built with whatever --tag /
    # --integration the operator happened to remember, and a forgotten one does
    # not fail at create time. It fails later, as a clone that cannot
    # authenticate or an MCP server that is quietly absent, on a VM that already
    # looks healthy. `iv-docs` carries six attachments plus a tag; reproducing
    # that from memory is not a reasonable ask.
    #
    # exe.dev fixes both image and integrations at creation, so getting this
    # wrong is not adjustable afterwards — it is another recreate.
    if [[ "$INHERIT" == true ]]; then
        step "inherit capabilities from $RECREATE"

        local_tags=$(ssh -o ConnectTimeout=30 exe.dev ls --json 2>/dev/null \
            | jq -r --arg n "$RECREATE" '.vms[] | select(.vm_name==$n) | .tags[]?')

        # Attachment specs live at the end of each `integrations list` row as
        # bare tokens (vm:NAME, tag:NAME, auto:all). Match the token, not the
        # column, since the middle columns vary by integration type.
        int_list=$(ssh -o ConnectTimeout=30 exe.dev integrations list 2>/dev/null)

        # Directly attached (vm:$RECREATE) — these do NOT follow a tag, so the
        # replacement only gets them if we ask for them explicitly.
        local_direct=$(awk -v vm="vm:$RECREATE" '{for(i=1;i<=NF;i++) if($i==vm){print $1; break}}' <<<"$int_list")

        missing_int=()
        for t in $local_tags; do
            mapped=$(map_tag "$t")
            if [[ -z "$mapped" ]]; then echo "  - tag $t (dropped: $(why_tag "$t"))"; continue; fi
            [[ "$mapped" != "$t" ]] && echo "  ~ tag $t -> $mapped"
            if [[ " ${TAGS[*]-} " == *" $mapped "* ]]; then continue; fi
            TAGS+=("$mapped"); [[ "$mapped" == "$t" ]] && echo "  + tag $mapped"
        done
        for i in $local_direct; do
            mapped=$(map_int "$i")
            if [[ -z "$mapped" ]]; then echo "  - integration $i (dropped: $(why_int "$i"))"; continue; fi
            [[ "$mapped" != "$i" ]] && echo "  ~ integration $i -> $mapped"
            if [[ " ${INTEGRATIONS[*]-} " == *" $mapped "* ]]; then continue; fi
            INTEGRATIONS+=("$mapped"); [[ "$mapped" == "$i" ]] && echo "  + integration $mapped (direct)"
            # A mapped name that does not exist yet would fail at create time,
            # after the old VM has already been quiesced. Check now.
            grep -qE "^$mapped[[:space:]]" <<<"$int_list" || missing_int+=("$mapped|$i")
        done

        # A RENAMED TAG THAT GRANTS NOTHING is the quiet failure this whole
        # migration is meant to avoid: the new VM comes up with tag:notion,
        # looks correct in `ls`, and has simply lost Notion access. Compare what
        # the old tag grants (mapped through map_int) against what the new one
        # does, and refuse to proceed on a mismatch.
        for t in $local_tags; do
            mapped=$(map_tag "$t"); [[ -z "$mapped" || "$mapped" == "$t" ]] && continue
            for old_grant in $(awk -v tg="tag:$t" '{for(i=1;i<=NF;i++) if($i==tg){print $1; break}}' <<<"$int_list"); do
                want=$(map_int "$old_grant"); [[ -z "$want" ]] && continue
                if ! awk -v tg="tag:$mapped" -v n="$want" '$1==n{for(i=1;i<=NF;i++) if($i==tg) found=1} END{exit !found}' <<<"$int_list"; then
                    echo "  !! tag:$mapped does not grant $want (tag:$t granted $old_grant)"
                    echo "     fix: ssh exe.dev integrations attach $want tag:$mapped"
                    tag_gap=1
                fi
            done
        done
        [[ -n "${tag_gap:-}" ]] && die "renamed tag(s) would grant less than the original — see above"

        # WORK REPOS. Inheriting the integration is not the same as having the
        # work: the replacement would come up authorised to clone ave-adapters
        # and simply not have it. Read what the source VM actually has checked
        # out rather than trusting the operator to remember --repo.
        #
        # dotfiles and iv-image are excluded — the provisioners clone those
        # themselves, from github.com.
        # DEPTH AND LAYOUT, not just a set of repo names. `~/*/` alone found
        # NOTHING on iv-foundry-stage2, whose entire working set lives in
        # ~/worktrees/<name>; the replacement came up with only dotfiles and
        # iv-image, passed every check, and was retired that way. iv-docs also
        # keeps work in ~/github/<owner>/<repo> and ~/worktrees/<name>/adapters.
        #
        # A worktree's .git is a FILE, so test -e, not -d.
        #
        # dotfiles and iv-image are skipped only at the TOP level, where the
        # provisioners clone them anyway — ~/worktrees/dotfiles-ro is real work
        # and must be reproduced.
        if [[ ${#CHECKOUTS[@]} -eq 0 ]]; then
            while IFS='|' read -r cpath u cbranch csha; do
                [[ -z "$cpath" ]] && continue
                r=$(sed -E 's#.*[/:]([^/]+/[^/]+)\.git$#\1#' <<<"$u")
                [[ "$r" == "$u" ]] && continue          # unparseable remote

                # Only clone what the replacement can actually reach. A VM can
                # hold a checkout of a repo whose integration we are
                # deliberately NOT carrying forward — iv-docs had
                # ~/entire-agent-migration long after entire-agent-shelley was
                # detached from it — and cloning that fails mid-run with a 403
                # after the VM is already built. Narrowing authority should drop
                # the checkout, not break the recreate.
                granted=""
                for iname in $(awk -v repo="repos=$r" '$0 ~ repo {print $1}' <<<"$int_list"); do
                    [[ " ${INTEGRATIONS[*]-} " == *" $iname "* ]] && granted=1
                    for t in ${TAGS[@]+"${TAGS[@]}"}; do
                        awk -v n="$iname" -v tg="tag:$t" '$1==n{for(i=1;i<=NF;i++) if($i==tg) f=1} END{exit !f}' <<<"$int_list" && granted=1
                    done
                done
                # A public repo needs no integration at all.
                if [[ -z "$granted" ]] && command -v gh >/dev/null 2>&1; then
                    [[ "$(gh repo view "$r" --json isPrivate -q .isPrivate 2>/dev/null)" == "false" ]] && granted=1
                fi
                if [[ -z "$granted" ]]; then
                    echo "  - repo $r (skipped: nothing grants it on the replacement)"
                    continue
                fi
                CHECKOUTS+=("$cpath|$r|$cbranch|$csha")
                echo "  + $cpath ($r @ ${csha:0:7}, $cbranch)"
            done < <(ssh -o ConnectTimeout=45 "$RECREATE" 'for d in ~/*/ ~/*/*/ ~/*/*/*/; do
                    [ -e "$d/.git" ] || continue
                    rel=${d#$HOME/}; rel=${rel%/}
                    [ "$rel" = dotfiles ] && continue
                    [ "$rel" = iv-image ] && continue
                    u=$(git -C "$d" remote get-url origin 2>/dev/null) || continue
                    echo "$rel|$u|$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null)|$(git -C "$d" rev-parse HEAD 2>/dev/null)"
                done' 2>/dev/null)
        fi

        if (( ${#missing_int[@]} )); then
            echo ""
            echo "  These renamed integrations do not exist yet. Create them, then re-run:"
            for m in "${missing_int[@]}"; do
                new="${m%%|*}"; old="${m##*|}"
                # "<repo>|<flags>" — a single field would make the no-flags case
                # ambiguous, and ${spec#* } then duplicated the repo name.
                spec=$(awk -v n="$old" '$1==n{for(i=1;i<=NF;i++){if($i ~ /^repos=/) r=substr($i,7); if($i=="readonly") f=f" --readonly"; if($i=="act-as-user") f=f" --act-as-user"}; print r "|" f}' <<<"$int_list")
                echo "    ssh exe.dev integrations add github --name=$new --repository=${spec%%|*}${spec#*|}"
            done
            die "missing renamed integrations (see above)"
        fi

        # Report what arrives WITHOUT being asked for, so the full capability
        # set of the new VM is visible here rather than discovered later.
        for t in $local_tags; do
            awk -v tg="tag:$t" '{for(i=1;i<=NF;i++) if($i==tg){print "  . " $1 " (inherited via tag:" substr(tg,5) ")"; break}}' <<<"$int_list"
        done
        awk '{for(i=1;i<=NF;i++) if($i=="auto:all"){print "  . " $1 " (auto:all — every VM)"; break}}' <<<"$int_list"

        echo "  review the list above: exe.dev fixes integrations at creation."
    else
        echo "  --no-inherit: capability set NOT copied from $RECREATE"
    fi
fi

# --- phase 1: create --------------------------------------------------------
if should_run create; then
step "create $NAME from $IMAGE"

create_args=(new "--name=$NAME" "--image=$IMAGE" "--disk=$DISK" "--cpu=$CPU" "--memory=$MEM")
for t in "${TAGS[@]+"${TAGS[@]}"}"; do create_args+=("--tag=$t"); done
# Repo integrations must be attached at creation or the VM cannot clone.
# Skipped when inheriting: --recreate already resolved the real integration
# names (repo-<x>-rw / -ro), and deriving a second name from the repo would
# re-grant the OLD one we are migrating away from.
if [[ -z "$RECREATE" || "$INHERIT" != true ]]; then
    for r in "${REPOS[@]+"${REPOS[@]}"}"; do
        INTEGRATIONS+=("repo-${r##*/}-rw")
    done
fi
# NO bootstrap integration. Both iv-image and dotfiles are public repos
# (iv-image was made public 2026-07-29), so a fresh VM clones both straight
# from github.com and needs no credential at all to provision itself. The two
# readonly github integrations that used to be attached to all 7 VMs are pure
# surplus authority now, and are dropped on migration.
# De-duplicate inherited integrations. Every expansion here is guarded with
# ${a[@]+...}: with both bootstrap repos public, a plain dev VM can now
# legitimately need ZERO integrations, and bash 3.2 (macOS) treats an unguarded
# empty-array expansion as an unbound variable under `set -u`.
seen_int=" "
deduped=()
for i in ${INTEGRATIONS[@]+"${INTEGRATIONS[@]}"}; do
    [[ "$seen_int" == *" $i "* ]] && continue
    seen_int+="$i "
    deduped+=("$i")
done
INTEGRATIONS=(${deduped[@]+"${deduped[@]}"})
for i in ${INTEGRATIONS[@]+"${INTEGRATIONS[@]}"}; do create_args+=("--integration=$i"); done

run ssh -o ConnectTimeout=60 exe.dev "${create_args[@]}"

# exe.dev drops repeated SYNs per source IP; one attempt, generous timeout.
[[ "$DRY" == true ]] || { echo "  waiting for boot..."; sleep 25; }
fi

# Before the tailnet join the VM is reachable ONLY over the exe.dev edge; after
# it, by MagicDNS short name. Using the wrong one is not a slow failure, it is
# "Could not resolve hostname".
EDGE="$NAME.exe.xyz"

# --- phase 2: team layer ----------------------------------------------------
if should_run team; then
step "provision team layer (iv-image)"
checkout=""
[[ -n "$IV_PIN" ]] && checkout="&& git -C ~/iv-image checkout --detach $IV_PIN"
run ssh -o ConnectTimeout=300 -o StrictHostKeyChecking=accept-new "$EDGE" "bash -lc '
    git clone -q https://github.com/kylelundstedt/iv-image.git ~/iv-image $checkout
    ~/iv-image/provision-iv.sh'"
fi

# --- phase 3: personal overlay ---------------------------------------------
if should_run overlay && [[ "$SKIP_OVERLAY" != true ]]; then
    step "personal overlay (dotfiles)"
    # provision-iv.sh overwrites ~/.claude/settings.json with the team default,
    # so the overlay MUST run after it or the SessionStart refresh hook is lost.
    run ssh -o ConnectTimeout=600 "$EDGE" "bash -lc '
        git clone -q https://github.com/kylelundstedt/dotfiles.git ~/dotfiles
        cd ~/dotfiles && ./install.sh'"
fi

# --- phase 3b: work repos ---------------------------------------------------
# BEFORE the provision-iv.sh re-run in phase 5, not after. provision-iv.sh
# installs some tooling conditionally on what is checked out — Quarto only when
# a _quarto.yml exists under $HOME. With the clone last, a recreated doc-site VM
# came up with no renderer at all and nothing said so: observed on
# iv-ave-adapters-next, "Quarto skipped (no _quarto.yml under $HOME)" on a VM
# whose whole job is rendering a Quarto site.
#
# Uses the generic github.int.exe.xyz host, which routes by repo path across
# whatever github integrations are attached. The per-integration host bakes the
# integration NAME into the URL, which would break the moment it is renamed.
if should_run repos; then
# --repo on a fresh VM has no layout to preserve: clone to ~/<name> on the
# default branch, the same shape --recreate records.
for r in "${REPOS[@]+"${REPOS[@]}"}"; do
    CHECKOUTS+=("${r##*/}|$r||")
done

for c in ${CHECKOUTS[@]+"${CHECKOUTS[@]}"}; do
    cpath="${c%%|*}"; rest="${c#*|}"
    crepo="${rest%%|*}"; rest="${rest#*|}"
    cbranch="${rest%%|*}"; csha="${rest#*|}"
    step "clone $crepo -> ~/$cpath"

    # Reproduce the CHECKOUT, not just the repo: branch and commit both. A
    # branch may no longer exist upstream while its commits do (merged and
    # deleted), so -B recreates it locally at the recorded sha. Rows recorded
    # as detached (branch=HEAD) stay detached.
    ckout="git -C ~/$cpath checkout -q -B '$cbranch' '$csha'"
    [[ -z "$cbranch" ]] && ckout="true"
    [[ "$cbranch" == HEAD ]] && ckout="git -C ~/$cpath checkout -q '$csha'"

    # RETRY: exe.dev's integration plumbing is eventually consistent on first
    # use — the github proxy answered "repository not found" for a repo whose
    # integration was attached at creation, then served it minutes later.
    # Public repos need no integration at all and the proxy 403s without one,
    # hence the github.com fallback.
    run ssh -o ConnectTimeout=300 "$EDGE" "bash -lc '
        mkdir -p ~/$(dirname "$cpath")
        for i in 1 2 3 4 5; do
            git clone -q https://github.int.exe.xyz/$crepo.git ~/$cpath && break
            rm -rf ~/$cpath
            git clone -q https://github.com/$crepo.git ~/$cpath && break
            rm -rf ~/$cpath
            echo \"  clone of $crepo not ready (attempt \$i/5); retrying in 10s\" >&2
            sleep 10
        done
        [ -e ~/$cpath/.git ] || exit 1
        $ckout'"
done

# SERVE the site, do not merely render it. provision-docsite points nginx at
# <repo>/_site on :8000, the port exe.dev proxies. Nothing invoked it before, so
# every recreated doc VM came up rendering correctly and serving nothing —
# exe.dev's own error page reads "Port 8000 unbound". One repo per VM, which is
# what provision-docsite assumes.
if [[ "$DRY" == true ]]; then
    step "serve doc site"
    echo "  [dry-run] provision-docsite <repo> if one carries a _quarto.yml"
else
    site=$(ssh -o ConnectTimeout=45 "$EDGE" 'for d in ~/*/; do
            [ -e "$d/_quarto.yml" ] || continue
            b=$(basename "$d"); [ "$b" = dotfiles ] && continue; [ "$b" = iv-image ] && continue
            echo "$b"; break
        done' 2>/dev/null)
    if [[ -n "$site" ]]; then
        step "serve doc site ($site)"
        run ssh -o ConnectTimeout=900 "$EDGE" "bash -lc 'provision-docsite ~/$site'"
    fi
fi
fi

# --- phase 4: tailnet -------------------------------------------------------
if should_run tailnet; then
step "join tailnet"
# AFTER the overlay, not before: exeslim-dev ships no tailscaled (exeuntu did),
# and dotfiles' install.sh is what installs Tailscale on Linux. Joining first
# fails with "tailscaled socket never appeared" — measured on the first live run
# of this script, 2026-07-29.
#
# This ordering works because the clones above go over the *.exe.xyz edge via
# repo integrations, which needs no tailnet. Everything that DOES need the
# tailnet — AgentsView's source daemon binding the tailnet IP, and the collector
# reaching it — comes after.
[[ "$DRY" == true ]] || ssh -o ConnectTimeout=60 "$EDGE" \
    'command -v tailscale >/dev/null' \
    || die "tailscale missing after overlay — install.sh's Linux path did not run"
run "$HOME/.agents/skills/join-tailnet/join-tailnet.sh" "$NAME"

# Post-condition: "joined" is not "reachable as $NAME". A VM that came up under
# its <name>-next staging identity is Running but invisible to peers as $NAME,
# and a tailscaled restart would NOT correct it (the tailnet name is a saved
# `up --hostname` pref — only a re-register does). join-tailnet is now
# idempotent toward the requested hostname, so re-running it re-registers a
# mis-named node; verify from here (this host is on the tailnet) that the
# canonical name actually resolves AND accepts TCP:22, and re-register until it
# does. Measured on a canary 2026-08-02.
if [[ "$DRY" != true ]]; then
    verify_tailnet_name() {
        local ip i
        for i in 1 2 3 4 5; do
            ip=$(tailscale ip -4 "$NAME" 2>/dev/null | head -1)
            [[ -n "$ip" ]] && (exec 3<>"/dev/tcp/$ip/22") 2>/dev/null && return 0
            sleep 3
        done
        return 1
    }
    tries=0
    until verify_tailnet_name; do
        tries=$((tries + 1))
        (( tries > 3 )) && die "VM is up but not reachable as '$NAME' on the tailnet after $tries re-register attempts — the node may be stuck under its -next name (check 'ssh $EDGE tailscale status')"
        echo "  not yet reachable as $NAME on the tailnet — re-registering (attempt $tries/3)"
        run "$HOME/.agents/skills/join-tailnet/join-tailnet.sh" "$NAME"
    done
    echo "  verified: reachable as $NAME on the tailnet"
fi

# --- phase 5: AgentsView enrollment ----------------------------------------
fi

if should_run agentsview; then
step "enroll in AgentsView"
# Fail-closed by design: the source daemon stays disabled until BOTH a tailnet
# address and a per-host token exist. Both sides must be written — the token on
# the VM and a matching [[remote_hosts]] entry on the collector — or the VM
# collects nothing and agentsview-coverage pages.
TOKEN="$(openssl rand -base64 48 | tr -d '\n')"

if [[ "$DRY" == true ]]; then
    echo "  [dry-run] write ~/.config/agentsview/source.env on $NAME (0600)"
    echo "  [dry-run] append [[remote_hosts]] for $NAME to $COLLECTOR_CONF"
else
    ssh -o ConnectTimeout=60 "$NAME" "bash -lc '
        mkdir -p ~/.config/agentsview
        umask 077
        printf \"AGENTSVIEW_AUTH_TOKEN=%s\n\" \"$TOKEN\" > ~/.config/agentsview/source.env
        chmod 600 ~/.config/agentsview/source.env
        ~/iv-image/provision-iv.sh >/dev/null'"

    cp "$COLLECTOR_CONF" "$COLLECTOR_CONF.bak-$(date +%Y%m%d%H%M%S)"
    python3 - "$COLLECTOR_CONF" "$NAME" "$TOKEN" "$TAILNET_DOMAIN" <<'PY'
import sys, pathlib
conf, name, token, domain = sys.argv[1:5]
p = pathlib.Path(conf); s = p.read_text()
if f'host = "{name}"' in s:
    sys.exit(f"collector already has an entry for {name}")
s = s.rstrip("\n") + f'''

[[remote_hosts]]
  host = "{name}"
  interval = "15m"
  transport = "http"
  url = "http://{name}.{domain}:8080"
  token = "{token}"
'''
p.write_text(s)
print(f"  collector: added {name}")
PY
    launchctl kickstart -k "$COLLECTOR_LABEL" >/dev/null 2>&1 || true
    sleep 5
fi

echo "  token: stored on VM + collector. Mirror it in 1Password ('AgentsView fleet tokens')."

# (work repos are cloned in phase 3b, before provision-iv.sh re-runs)

# --- phase 7: verify --------------------------------------------------------
fi

if should_run verify; then
step "verify"
if [[ "$DRY" == true ]]; then
    echo "  [dry-run] skipping verification"
else
    ssh -o ConnectTimeout=60 "$NAME" "bash -lc '
        echo \"  provision lock: \$(head -1 ~/iv-provision.lock 2>/dev/null || echo MISSING)\"
        echo \"  agentsview unit: \$(systemctl --user is-active agentsview-source.service 2>/dev/null)\"
        echo \"  failed units: \$(systemctl list-units --state=failed --no-legend | wc -l)\"
        echo \"  disk: \$(df -h / | tail -1 | awk \"{print \\\$3}\")\"
        for q in ~/*/_quarto.yml; do
            [ -e \"\$q\" ] || continue
            d=\$(basename \$(dirname \"\$q\"))
            case \"\$d\" in iv-image|dotfiles) continue ;; esac
            command -v quarto >/dev/null \
                && echo \"  renderer: quarto present (\$d needs it)\" \
                || echo \"  !! renderer MISSING: \$d has _quarto.yml but quarto is not installed\"
            # SERVING is a separate claim from RENDERING, and the one that
            # matters. Every doc site went dark at cutover because exeslim-dev
            # shipped no nginx and nothing ran provision-docsite — while this
            # check happily reported the renderer present. exe.dev proxies
            # :8000, so an unbound port means the site is down.
            code=\$(curl -s -o /dev/null -w %{http_code} --max-time 10 http://localhost:8000/ 2>/dev/null || echo 000)
            [ \"\$code\" = 200 ] \
                && echo \"  docsite: serving on :8000 (HTTP 200)\" \
                || echo \"  !! docsite NOT SERVED: :8000 returned \$code — run provision-docsite ~/\$d\"
            break
        done'"

    # The control-plane escalation check: a VM must NOT be able to reach
    # exe.dev. ControlPath=none is REQUIRED — a warm multiplexed socket makes a
    # plain `ssh exe.dev whoami` pass even when auth would fail.
    if ssh -o ConnectTimeout=30 "$NAME" \
        "ssh -o BatchMode=yes -o ConnectTimeout=12 -o ControlPath=none -o ControlMaster=no exe.dev whoami" \
        >/dev/null 2>&1; then
        echo "  !! WARNING: $NAME can reach the exe.dev control plane — investigate before use"
    else
        echo "  control-plane reachable from VM: no (correct)"
    fi

    echo "  agentsview coverage:"
    "$HOME/.local/bin/agentsview-coverage" --dry-run 2>&1 | tail -3 | sed 's/^/    /'
fi
fi

# --- retirement (never automatic) ------------------------------------------
if [[ -n "$RECREATE" ]]; then
    cat <<EOF

== retire $RECREATE — NOT done automatically

Verify the new VM first (render its site if it serves one), then:

  retire-vm $RECREATE --replaced-by $NAME --delete

which refuses if any repo on $RECREATE has uncommitted or unpushed work,
removes the collector entry BEFORE deleting, then restores the canonical
name — exe.dev rename, OS/Tailscale hostname, and the collector URL, all
of which embed it.

Still yours to confirm first: that no external dependency uses the old
name (custom domains, webhooks, anything pinned to its tailnet hostname).
EOF
fi

step "done: $NAME"
