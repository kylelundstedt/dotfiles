{
  "statusLine": {
    "type": "command",
    "command": "cship"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "env": {
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/refresh-env.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
