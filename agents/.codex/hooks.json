{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/refresh-env.sh\"",
            "timeout": 20,
            "statusMessage": "Refreshing dotfiles"
          }
        ]
      }
    ]
  }
}
