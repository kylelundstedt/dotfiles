#!/usr/bin/env bash
set -euo pipefail

# Check if signed in to 1Password (fail fast instead of hanging)
if ! timeout 5 op account get --account industryvault.1password.com >/dev/null 2>&1; then
    echo "Error: Not signed in to 1Password (industryvault.1password.com)" >&2
    exit 1
fi

SCRIPT_DIR="$(dirname "$0")"
exec op run --env-file="$SCRIPT_DIR/tigris-mcp.env" \
    --account industryvault.1password.com -- npx -y @tigrisdata/tigris-mcp-server run "$@"
