#!/usr/bin/env bash
# Local health/freshness check for the mini's AgentsView collector.
# An optional healthchecks.io ping URL may be stored as
# agentsview:healthcheck-url in the login Keychain.
set -euo pipefail
umask 077

source "$HOME/dotfiles/backup/_lib.sh"
job_require_mini agentsview-healthcheck
job_hc_init "agentsview:healthcheck-url"
job_log "$HOME/Library/Logs/agentsview-healthcheck"

fail() {
    local reason=$1
    echo "FAIL: $reason"
    job_hc /fail --data-raw "agentsview-healthcheck $(date '+%F %T') $reason"
    exit 1
}

# Token lives in the mode-0600 config (Keychain fan-out never happened;
# the collector role that needed it has moved to iv-agentsview anyway).
TOKEN=$(sed -nE 's/^auth_token[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' "$HOME/.agentsview/config.toml" | head -1)
if [[ -z "$TOKEN" && -f "$HOME/.agentsview/config.toml" ]]; then
    TOKEN=$(sed -nE \
        's/^auth_token[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' \
        "$HOME/.agentsview/config.toml" | head -1)
fi
[[ -n "$TOKEN" ]] || fail "auth token missing from Keychain and config.toml"
TS_BIN=$(command -v tailscale || true)
[[ -n "$TS_BIN" ]] || [[ ! -x /opt/homebrew/bin/tailscale ]] || TS_BIN=/opt/homebrew/bin/tailscale
[[ -n "$TS_BIN" ]] || fail "tailscale not installed"
# Probe the source daemon directly on loopback (the :8443 collector front was
# retired 2026-09-02; the global collector now runs on iv-agentsview),
# so this exercises the same path a browser hits — real cert, proxy, and auth —
# not just the loopback backend. A cert or proxy fault now trips the check.
TS_FQDN=$($TS_BIN status --json 2>/dev/null | jq -r '.Self.DNSName // empty' | sed 's/\.$//')
[[ -n "$TS_FQDN" ]] || fail "no Tailscale MagicDNS name"
BASE="http://127.0.0.1:8080"

job_hc /start
curl -fsS --max-time 15 -H "Authorization: Bearer $TOKEN" \
    "$BASE/api/ping" >/dev/null || fail "authenticated ping failed"
status=$(curl -sS --max-time 15 -o /dev/null -w '%{http_code}' \
    "$BASE/api/v1/settings" || true)
[[ "$status" == "401" ]] || fail "unauthenticated API returned HTTP $status, expected 401"

DATA_DIR=${AGENTSVIEW_DATA_DIR:-$HOME/.agentsview}
DB="$DATA_DIR/sessions.db"
[[ -s "$DB" ]] || fail "sessions.db missing or empty"

# Once remote hosts are configured, the collector's coordinated sync timestamp
# must stay close to the five-minute per-host schedule. Allow 20 minutes for a
# slow fleet sync before alerting.
if grep -q '^\[\[remote_hosts\]\]' "$DATA_DIR/config.toml" 2>/dev/null; then
    finished=$(sqlite3 "$DB" \
        "SELECT value FROM pg_sync_state WHERE key='last_sync_finished_at';" \
        2>/dev/null || true)
    [[ -n "$finished" ]] || fail "no completed sync timestamp"
    age=$(python3 - "$finished" <<'PY'
import datetime as dt
import re
import sys
# Age is integer seconds, so drop sub-second precision entirely. Python < 3.11
# (launchd resolves python3 to /usr/bin/python3 = 3.9) rejects fromisoformat
# fractions that aren't 3 or 6 digits, and Postgres strips trailing zeros
# (e.g. ".571730" -> ".57173", 5 digits) — the intermittent 2026-07-25 flap.
value = re.sub(r"\.\d+", "", sys.argv[1].replace("Z", "+00:00"))
when = dt.datetime.fromisoformat(value)
now = dt.datetime.now(dt.timezone.utc)
print(max(0, int((now - when).total_seconds())))
PY
)
    (( age <= 1200 )) || fail "last completed sync is ${age}s old"
fi

# Freshness alone cannot see a source that fails every run: the collector still
# finishes on schedule while one host contributes nothing. On 2026-07-22 a
# zero-byte local shelley.db failed 73 consecutive syncs with every check green.
failed=$(curl -fsS --max-time 15 -H "Authorization: Bearer $TOKEN" \
    "$BASE/api/v1/sync/status" 2>/dev/null |
    sed -nE 's/.*"failed"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' | head -1)
[[ -n "$failed" ]] || fail "sync status reported no failed count"
(( failed == 0 )) || fail "last sync reported ${failed} failed source(s)"

# Every configured source must still answer authenticated and reject anonymous
# requests. Retiring a VM means removing its [[remote_hosts]] block in the same
# change, otherwise this check alarms on a host that is gone on purpose.
sources=0
while read -r host url token; do
    [[ -n "$host" ]] || continue
    sources=$((sources + 1))
    code=$(curl -sS --max-time 15 -o /dev/null -w '%{http_code}' \
        -H "Authorization: Bearer $token" "${url}/api/v1/version" || true)
    [[ "$code" == "200" ]] ||
        fail "source ${host} answered HTTP ${code} to an authenticated probe"
    code=$(curl -sS --max-time 15 -o /dev/null -w '%{http_code}' \
        "${url}/api/v1/version" || true)
    [[ "$code" == "401" ]] ||
        fail "source ${host} answered HTTP ${code} anonymously, expected 401"
done < <(awk -F'"' '
    # Key order inside a block is not guaranteed — the first two canaries were
    # written token-before-url — so collect the whole block and emit on exit.
    function flush() {
        if (h != "" && u != "" && t != "") print h, u, t
        h = ""; u = ""; t = ""
    }
    /^\[\[remote_hosts\]\]/ { flush(); next }
    /^[[:space:]]*host[[:space:]]*=/  { h = $2 }
    /^[[:space:]]*url[[:space:]]*=/   { u = $2 }
    /^[[:space:]]*token[[:space:]]*=/ { t = $2 }
    END { flush() }
' "$DATA_DIR/config.toml")

# The nightly Tigris job refreshes this staged online-backup snapshot. A copy
# older than 30 hours means either snapshot preparation or the backup cascade
# has missed its expected daily run.
SNAPSHOT_MANIFEST="$HOME/archives/agentsview/manifest.json"
[[ -s "$SNAPSHOT_MANIFEST" ]] || fail "snapshot manifest missing"
snapshot_created=$(sed -nE \
    's/.*"created_utc"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' \
    "$SNAPSHOT_MANIFEST" | head -1)
[[ -n "$snapshot_created" ]] || fail "snapshot timestamp missing"
snapshot_age=$(python3 - "$snapshot_created" <<'PY'
import datetime as dt
import re
import sys
# Age is integer seconds, so drop sub-second precision entirely. Python < 3.11
# (launchd resolves python3 to /usr/bin/python3 = 3.9) rejects fromisoformat
# fractions that aren't 3 or 6 digits, and Postgres strips trailing zeros
# (e.g. ".571730" -> ".57173", 5 digits) — the intermittent 2026-07-25 flap.
value = re.sub(r"\.\d+", "", sys.argv[1].replace("Z", "+00:00"))
when = dt.datetime.fromisoformat(value)
now = dt.datetime.now(dt.timezone.utc)
print(max(0, int((now - when).total_seconds())))
PY
)
(( snapshot_age <= 108000 )) || fail "snapshot is ${snapshot_age}s old"

job_hc
echo "OK: authenticated, unauthenticated rejected, archive and snapshot fresh," \
    "${sources} source(s) reachable with no failed syncs"
