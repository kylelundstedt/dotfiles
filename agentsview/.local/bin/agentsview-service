#!/usr/bin/env bash
# AgentsView SOURCE DAEMON on klundstedt-mini (demoted from global collector
# 2026-09-02; the collector now runs on iv-agentsview). Serves this machine
# agent sessions on :8080 for the collector to pull, token-authed
# (auth_token in mode-0600 config.toml). launchd owns this foreground process.
set -euo pipefail
umask 077

source "$HOME/dotfiles/backup/_lib.sh"
job_require_mini agentsview

DATA_DIR=${AGENTSVIEW_DATA_DIR:-$HOME/.agentsview}
mkdir -p "$DATA_DIR"; chmod 700 "$DATA_DIR"
[[ -f "$DATA_DIR/config.toml" ]] && chmod 600 "$DATA_DIR/config.toml"

AGENTSVIEW_BIN=$(command -v agentsview || true)
[[ -n "$AGENTSVIEW_BIN" ]] || [[ ! -x /opt/homebrew/bin/agentsview ]] || AGENTSVIEW_BIN=/opt/homebrew/bin/agentsview
[[ -n "$AGENTSVIEW_BIN" ]] || { echo "FATAL: agentsview not installed" >&2; exit 1; }

# Muzzle every agent root under ~/Library (TCC prompt blocks headless agents;
# see prior outage 2026-07-25). Scope: Claude Code + Codex + Shelley only.
NO_SCAN="$DATA_DIR/no-scan"
mkdir -p "$NO_SCAN"
export COWORK_DIR="$NO_SCAN" ZED_DIR="$NO_SCAN" \
       WARP_DIR="$NO_SCAN" VSCODE_COPILOT_DIR="$NO_SCAN"
export AGENTSVIEW_DATA_DIR="$DATA_DIR"

exec "$AGENTSVIEW_BIN" serve \
    --host 0.0.0.0 \
    --port 8080 \
    --no-browser \
    --no-update-check \
    --require-auth
