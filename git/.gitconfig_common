# No default [user] — identity comes from includeIf in .gitconfig
# (personal via .gitconfig_personal, work via .gitconfig_work).
# Committing outside those directories without .gitconfig_local will error.

[core]
excludesfile = ~/.gitignore_global
compression = 9
editor = nano

# Prevent line ending issues--change to 'true' on Windows
autocrlf = input

[alias]
empty = commit --allow-empty-message -m ''
amend = commit --amend -C HEAD --allow-empty-message

[push]
default = simple

[hub]
protocol = ssh # Use SSH for better security with 1Password

# Rewrite HTTPS GitHub URLs to SSH so 1Password handles auth
[url "git@github.com:"]
    insteadOf = https://github.com/

[credential]

[filter "lfs"]
clean = git-lfs clean -- %f
smudge = git-lfs smudge -- %f
process = git-lfs filter-process
required = true
[pull]
ff = only

[gpg]
  format = ssh

[gui]
# editor set by shell $EDITOR; VS Code overrides via .gitconfig_macos

[commit]
  gpgsign = true
