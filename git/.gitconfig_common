# No default [user] — identity comes from includeIf in .gitconfig
# (personal via .gitconfig_personal, work via .gitconfig_work).
# Committing outside those directories without .gitconfig_local will error.

[core]
excludesfile = ~/.gitignore_global
compression = 9
editor = nano

# Prevent line ending issues--change to 'true' on Windows
autocrlf = input

[alias]
empty = commit --allow-empty-message -m ''
amend = commit --amend -C HEAD --allow-empty-message

[push]
default = simple
autoSetupRemote = true

[filter "lfs"]
clean = git-lfs clean -- %f
smudge = git-lfs smudge -- %f
process = git-lfs filter-process
required = true
[pull]
ff = only

[gui]
# editor set by shell $EDITOR; VS Code overrides via .gitconfig_macos
