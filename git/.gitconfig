[include]
    path = ~/.gitconfig_common

# Local user-specific config (name, email) - gitignored, created by install script
# This file overrides the template values in .gitconfig_common
[include]
    path = ~/.gitconfig_local

# Identity by repo OWNER-ORG, read from the remote URL — path-independent, so it
# works on macOS (~/github/<org>/<repo>) AND exe.dev VMs (flat ~/<repo>), and it
# follows a repo when it migrates orgs. Fragments are gitignored, generated by
# install.sh. See agent_docs/git-identity.md.
#
# hasconfig matching is CASE-SENSITIVE. HTTPS URLs use an org path segment.
# GitHub uses canonical org case; the exe.dev proxy lowercases it, so mixed-case
# work orgs also get a lowercase proxy glob (**/org-lowercased/**).
[includeIf "hasconfig:remote.*.url:**/kylelundstedt/**"]
    path = ~/.gitconfig_personal
[includeIf "hasconfig:remote.*.url:**/IndustryVault/**"]
    path = ~/.gitconfig_work
[includeIf "hasconfig:remote.*.url:**/industryvault/**"]
    path = ~/.gitconfig_work
[includeIf "hasconfig:remote.*.url:**/iv-cmg/**"]
    path = ~/.gitconfig_work
[includeIf "hasconfig:remote.*.url:**/USAA/**"]
    path = ~/.gitconfig_work
[includeIf "hasconfig:remote.*.url:**/usaa/**"]
    path = ~/.gitconfig_work

# Generated by install.sh to include only one OS-specific file:
#   - ~/.gitconfig_macos or ~/.gitconfig_linux
[include]
    path = ~/.gitconfig_os_local
