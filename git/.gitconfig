[include]
    path = ~/.gitconfig_common

# Local user-specific config (name, email) - gitignored, created by install script
# This file overrides the template values in .gitconfig_common
[include]
    path = ~/.gitconfig_local

# Per-directory identity overrides (gitignored, created manually)
# ~/github/kylelundstedt/ = personal (kylelundstedt GitHub account)
# ~/github/klundstedt/    = work (industryvault GitHub Enterprise Cloud, SSO)
[includeIf "gitdir:~/github/kylelundstedt/"]
    path = ~/.gitconfig_personal
[includeIf "gitdir:~/github/klundstedt/"]
    path = ~/.gitconfig_work

# Generated by install.sh to include only one OS-specific file:
#   - ~/.gitconfig_macos or ~/.gitconfig_linux
[include]
    path = ~/.gitconfig_os_local
