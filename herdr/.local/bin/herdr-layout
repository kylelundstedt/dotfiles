#!/usr/bin/env bash
# herdr-layout — stamp a standard NAMED layout onto the LOCAL herdr server.
#
# Run it on the host whose herdr server you want the layout on (the mini or a
# VM), against a running herdr session. It builds a clean 3-pane workspace
# rooted in the host's project repo and closes any leftover shell pane:
#     <prefix>-claude (top-left) | <prefix>-codex (bottom-left) | yazi (right)
# If yazi isn't installed it's just the two stacked agents.
#
# Why the names matter: herdr sessions PERSIST — build a layout once and both
# the desk and the phone re-attach to the same agents. On a phone over Moshi you
# attach ONE agent full-screen: `herdr agent attach <prefix>-claude`. Build a
# VM's layout from the phone by mosh'ing to the mini, `ssh <vm> herdr-layout`,
# then `herdr --remote <vm>` and attach by name.
#
# Usage: herdr-layout [name-prefix]     # default prefix = the project repo name

set -uo pipefail

command -v herdr >/dev/null 2>&1 || { echo "herdr-layout: herdr not on PATH" >&2; exit 1; }

_pane_ids() { grep -o '"pane_id":"[^"]*"' | cut -d'"' -f4; }

# Project dir: current git repo, else the repo in $HOME that isn't
# dotfiles/iv-image, else $HOME.
proj_dir=""
if top=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null); then
  proj_dir="$top"
else
  for d in "$HOME"/*/; do
    d=${d%/}
    case "$(basename "$d")" in dotfiles | iv-image) continue ;; esac
    [ -d "$d/.git" ] && { proj_dir="$d"; break; }
  done
fi
proj_dir="${proj_dir:-$HOME}"
prefix="${1:-$(basename "$proj_dir")}"

# Idempotent: bail if the layout is already there.
if herdr agent list 2>/dev/null | grep -q "\"${prefix}-claude\""; then
  echo "herdr-layout: '${prefix}-claude' already exists — attach: herdr agent attach ${prefix}-claude" >&2
  exit 0
fi

echo "herdr-layout: building '${prefix}' rooted at ${proj_dir}"

# Pre-existing panes (leftover shells) — closed at the end so only the layout remains.
pre=$(herdr pane list 2>/dev/null | _pane_ids)

# claude in the main pane…
herdr agent start "${prefix}-claude" --cwd "$proj_dir" -- claude >/dev/null
# …yazi in a right-hand column (--no-focus keeps claude focused so codex splits
# claude, giving a full-height right column)…
if command -v yazi >/dev/null 2>&1; then
  yp=$(herdr pane split --direction right --cwd "$proj_dir" --no-focus 2>/dev/null | _pane_ids | head -1)
  if [ -n "${yp:-}" ]; then
    herdr pane send-text "$yp" "yazi" >/dev/null 2>&1
    herdr pane send-keys "$yp" Enter >/dev/null 2>&1
  fi
fi
# …codex stacked below claude.
herdr agent start "${prefix}-codex" --cwd "$proj_dir" --split down -- codex >/dev/null

# Drop the leftover shell pane(s) for a clean layout.
for p in $pre; do herdr pane close "$p" >/dev/null 2>&1 || true; done

yazi_note=""
command -v yazi >/dev/null 2>&1 && yazi_note="  |  yazi (right)"
cat <<EOF
herdr-layout: done — clean layout for '${prefix}'.
  agents : ${prefix}-claude, ${prefix}-codex${yazi_note}
  phone  : herdr agent attach ${prefix}-claude   (or ${prefix}-codex)
EOF
