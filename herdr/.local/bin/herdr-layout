#!/usr/bin/env bash
# herdr-layout — stamp a standard NAMED layout onto the LOCAL herdr server.
#
# Two modes:
#   herdr-layout [name]            desk  — claude (top) + codex (bottom), one split
#   herdr-layout [name] --phone    phone — claude + codex in SEPARATE TABS, so each
#                                   is full-screen and you swipe between them (a
#                                   side-by-side split is unusable on a phone)
#
# Run on the host whose herdr server you want the layout on (mini or a VM),
# against a running herdr session. Named agents so a phone can attach one
# full-screen with `herdr agent attach <name>`. herdr sessions persist — build
# once, attach from the desk or the phone.
#
# Usage: herdr-layout [name-prefix] [--phone]

set -uo pipefail

command -v herdr >/dev/null 2>&1 || { echo "herdr-layout: herdr not on PATH" >&2; exit 1; }

phone=false
prefix=""
for a in "$@"; do
  case "$a" in
    --phone) phone=true ;;
    -*) echo "herdr-layout: unknown flag '$a'" >&2; exit 1 ;;
    *) prefix="$a" ;;
  esac
done

# extract a JSON string field (e.g. pane_id, tab_id) from herdr's output
_field() { grep -o "\"$1\":\"[^\"]*\"" | cut -d'"' -f4; }

# Project dir: current git repo, else the repo in $HOME that isn't
# dotfiles/iv-image, else $HOME.
proj_dir=""
if top=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null); then
  proj_dir="$top"
else
  for d in "$HOME"/*/; do
    d=${d%/}
    case "$(basename "$d")" in dotfiles | iv-image) continue ;; esac
    [ -d "$d/.git" ] && { proj_dir="$d"; break; }
  done
fi
proj_dir="${proj_dir:-$HOME}"
prefix="${prefix:-$(basename "$proj_dir")}"

# Idempotent: bail if the layout is already there.
if herdr agent list 2>/dev/null | grep -q "\"${prefix}-claude\""; then
  echo "herdr-layout: '${prefix}-claude' already exists — attach: herdr agent attach ${prefix}-claude" >&2
  exit 0
fi

# Pre-existing (leftover shell) panes — closed at the end for a clean layout.
pre=$(herdr pane list 2>/dev/null | _field pane_id)

if $phone; then
  echo "herdr-layout: building '${prefix}' (phone / tabs) at ${proj_dir}"
  # claude in the current tab; label that tab so Moshi's tab-switcher is readable
  ctab=$(herdr agent start "${prefix}-claude" --cwd "$proj_dir" -- claude | _field tab_id | head -1)
  [ -n "${ctab:-}" ] && herdr tab rename "$ctab" "${prefix}-claude" >/dev/null 2>&1
  # codex in its own tab
  ntab=$(herdr tab create --cwd "$proj_dir" --label "${prefix}-codex" --no-focus 2>/dev/null | _field tab_id | head -1)
  if [ -n "${ntab:-}" ]; then
    herdr agent start "${prefix}-codex" --tab "$ntab" --cwd "$proj_dir" -- codex >/dev/null
  else
    herdr agent start "${prefix}-codex" --cwd "$proj_dir" -- codex >/dev/null # fallback: new pane
  fi
  hint="two tabs — swipe between ${prefix}-claude / ${prefix}-codex (each full-screen)"
else
  echo "herdr-layout: building '${prefix}' (desk / split) at ${proj_dir}"
  herdr agent start "${prefix}-claude" --cwd "$proj_dir" -- claude >/dev/null
  herdr agent start "${prefix}-codex" --cwd "$proj_dir" --split down -- codex >/dev/null
  hint="claude (top) / codex (bottom) split"
fi

# Drop the leftover shell pane(s).
for p in $pre; do herdr pane close "$p" >/dev/null 2>&1 || true; done

cat <<EOF
herdr-layout: done — ${prefix} (${hint}).
  agents: ${prefix}-claude, ${prefix}-codex
  phone : herdr agent attach ${prefix}-claude   (or ${prefix}-codex)
EOF
