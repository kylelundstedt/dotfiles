{
    "dotfiles.repository": "https://github.com/kylelundstedt/dotfiles",
    "snowflake.snowsqlConfigPath": "/Users/klundstedt/.snowsql/config",
    "chat.editing.alwaysSaveWithGeneratedChanges": true,
    "terminal.integrated.fontFamily": "Monaspace Neon",
    "terminal.integrated.scrollback": 500,
    "git.confirmSync": false,
    "workbench.startupEditor": "none",
    "explorer.confirmDelete": false,
    "terminal.external.osxExec": "Warp.app",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.enableImages": true,
    "terminal.integrated.enableMultiLinePasteWarning": false,
    "git.openRepositoryInParentFolders": "always",
    "workbench.colorTheme": "Default Dark Modern",
    "chat.disableAIFeatures": true,
    "editor.fontFamily": "Monaspace Neon",
    "editor.fontLigatures": true,
    "editor.fontSize": 13,
    "editor.lineHeight": 1.5,
    "window.titleBarStyle": "custom",
    "workbench.activityBar.location": "top",
    "editor.minimap.enabled": false,
    "breadcrumbs.enabled": false,
    "editor.renderLineHighlight": "none",
    "workbench.statusBar.visible": true,
    "window.commandCenter": true,
    "quarto.render.previewFormat": "pdf",
    "workbench.sideBar.location": "left",
    "panel.defaultLocation": "right"
}