<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kylelundstedt.agentsview-retention</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-l</string>
        <string>-c</string>
        <string>$HOME/.local/bin/agentsview-retention --apply</string>
    </array>
    <!-- No RunAtLoad: this stops the collector for the prune, so it should
         not fire on every login/reboot. -->
    <key>RunAtLoad</key>
    <false/>
    <!-- Daily, matching the healthchecks.io check. Each run stops the
         collector for only a few seconds, and daily keeps the eligible set
         small instead of letting a week accumulate. -->
    <key>StartInterval</key>
    <integer>86400</integer>
    <key>StandardOutPath</key>
    <string>/tmp/agentsview-retention.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/agentsview-retention.log</string>
</dict>
</plist>
