<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kylelundstedt.tigris-backup-reconcile</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-l</string>
        <string>-c</string>
        <string>$HOME/dotfiles/backup/tigris-backup.sh reconcile</string>
    </array>
    <!-- Sunday 06:00, after the daily 04:30 fast sync. This exact weekly pass
         reads per-object rclone mtimes and has its own long-grace check. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/tigris-backup-reconcile.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/tigris-backup-reconcile.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
