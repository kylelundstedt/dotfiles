server {
    # The exe.dev alternate-port proxy reaches the VM's loopback listener.
    listen 127.0.0.1:8085;
    server_name _;

    # Defense in depth beyond the integration attachment: peer integrations
    # deliver an attested caller identity in this header. Only the fleet's
    # authoring/control VM may read the global transcript archive through MCP.
    if ($http_x_exedev_source_vm != "iv-provision") {
        return 403;
    }

    location / {
        proxy_pass http://127.0.0.1:8086;
        proxy_http_version 1.1;
        # AgentsView MCP rejects the external target Host; present its actual
        # loopback listener while preserving every MCP/session response header.
        proxy_set_header Host 127.0.0.1:8086;
        proxy_set_header X-Exedev-Source-Vm $http_x_exedev_source_vm;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }
}
