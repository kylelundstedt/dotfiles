// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "ssh_connections": [
    {
      "host": "dotfiles",
      "username": "root",
      "args": [],
      "projects": [
        {
          "paths": [
            "/root/dotfiles"
          ]
        }
      ]
    },
    {
      "host": "gse-lld",
      "username": "root",
      "args": [],
      "projects": [
        {
          "paths": [
            "/root/gse-lld/./"
          ]
        }
      ]
    },
    {
      "host": "gitlake",
      "username": "root",
      "args": [],
      "projects": [
        {
          "paths": [
            "/root/gitlake"
          ]
        }
      ]
    }
  ],
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "agent": {
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "right"
  },
  "release_channel": "preview",
  "ui_font_size": 16,
  "buffer_font_size": 14,
  "theme": {
    "mode": "dark",
    "light": "GitHub Dark Colorblind",
    "dark": "GitHub Dark Colorblind",
  },
  "gutter": {
    "code_actions": false,
    "runnables": false,
    "breakpoints": false,
    "min_line_number_digits": 1,
  },
  "git": {
    "git_gutter": "hide",
    "inline_blame": {
      "enabled": false,
    },
  },
  "languages": {
    "Markdown": {
      "gutter": { "folds": false },
    },
  },
  "project_panel": {
    "dock": "right",
    "git_status": true,
  },
  "terminal": {
    "dock": "right",
  },
  "auto_install_extensions": {
    "dockerfile": true,
    "env": true,
    "github-theme": true,
    "graphviz": true,
    "jinja2": true,
    "mermaid": true,
    "quarto": true,
    "rainbow-csv": true,
    "sql": true,
    "toml": true,
    "typst": true
  },
  "agent_servers": {
    "cortex-code": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "auto"
      },
      "type": "registry"
    }
  },
}
