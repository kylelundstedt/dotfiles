#!/bin/bash
set -euo pipefail

# Unified Zed project launcher.
# Opens projects in Zed across local, OrbStack, Apple Container, and Sprite backends.
#
# Usage: zop [--backend local|orb|container|sprite] [--machine <name>] [--project <path>] [--org <org>]

BACKENDS_DIR="$(dirname "$(readlink -f "$0")")/zop-backends"

# --- Helpers ---

die() { echo "Error: $*" >&2; exit 1; }

# Pick from a list. Args: prompt, then items as arguments.
pick() {
    local prompt="$1"; shift
    local items=("$@")
    [[ ${#items[@]} -eq 0 ]] && die "Nothing to pick from"
    [[ ${#items[@]} -eq 1 ]] && echo "${items[0]}" && return
    printf '%s\n' "${items[@]}" | fzf --prompt="$prompt > " || exit 0
}

# Pick from a newline-delimited string. Args: prompt, multiline string.
pick_from() {
    local prompt="$1" input="$2"
    local count
    count=$(echo "$input" | wc -l | tr -d ' ')
    if [[ "$count" -eq 1 ]]; then
        echo "$input"
    else
        echo "$input" | fzf --prompt="$prompt > " || exit 0
    fi
}

ssh_pubkey() {
    local key
    key=$(ssh-add -L 2>/dev/null | head -1) || true
    [[ -z "$key" ]] && die "No SSH public keys found (is your SSH agent running?)"
    echo "$key"
}

# Run a command on the remote via SSH. Requires SSH_TARGET to be set.
remote_exec() {
    local ssh_host ssh_port
    if [[ "$SSH_TARGET" == *:* ]]; then
        ssh_host="${SSH_TARGET%:*}"
        ssh_port="${SSH_TARGET##*:}"
        ssh -A -o StrictHostKeyChecking=no -p "$ssh_port" "$ssh_host" "$@"
    else
        ssh -A -o StrictHostKeyChecking=no "$SSH_TARGET" "$@"
    fi
}

# Source a backend file, clearing previous backend functions first.
load_backend() {
    local name="$1"
    local file="$BACKENDS_DIR/${name}.sh"
    [[ -f "$file" ]] || die "Unknown backend: $name"
    # shellcheck source=/dev/null
    source "$file"
}

# Build combined target list across all available backends.
list_all_targets() {
    local backend bf machines
    for bf in "$BACKENDS_DIR"/*.sh; do
        [[ -f "$bf" ]] || continue
        backend="$(basename "$bf" .sh)"
        # shellcheck source=/dev/null
        source "$bf"
        if ! backend_available 2>/dev/null; then
            continue
        fi
        if [[ "$backend" == "local" ]]; then
            echo "local"
        else
            machines=$(backend_list 2>/dev/null) || true
            if [[ -n "$machines" ]]; then
                while IFS= read -r m; do
                    echo "$m ($backend)"
                done <<< "$machines"
            fi
        fi
    done
    echo "[+ new]"
}

# --- Argument parsing ---

BACKEND=""
MACHINE=""
PROJECT=""
ORG=""
IS_NEW_MACHINE=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --backend) BACKEND="$2"; shift 2 ;;
        --machine) MACHINE="$2"; shift 2 ;;
        --project) PROJECT="$2"; shift 2 ;;
        --org)     ORG="$2"; shift 2 ;;
        --help|-h)
            echo "Usage: zop [--backend local|orb|container|sprite] [--machine <name>] [--project <path>] [--org <org>]"
            echo ""
            echo "Opens a project in Zed. Prompts interactively for missing arguments."
            echo ""
            echo "Backends:"
            echo "  local       Local macOS project"
            echo "  orb         OrbStack Linux VM"
            echo "  container   Apple Container (macOS 26+)"
            echo "  sprite      Fly.io Sprite (remote)"
            echo ""
            echo "Options:"
            echo "  --backend   Backend type"
            echo "  --machine   Machine/VM/container/sprite name"
            echo "  --project   Project path on target"
            echo "  --org       Sprite organization (sprite backend only)"
            exit 0
            ;;
        -*) die "Unknown flag: $1" ;;
        *)  die "Unexpected argument: $1" ;;
    esac
done

# --- Step 1: Pick a target (required) ---

if [[ -z "$BACKEND" ]]; then
    targets=$(list_all_targets)
    selection=$(pick_from "Target" "$targets")

    if [[ "$selection" == "[+ new]" ]]; then
        # Provision a new machine — pick which backend type
        available=()
        for bf in "$BACKENDS_DIR"/*.sh; do
            [[ -f "$bf" ]] || continue
            b="$(basename "$bf" .sh)"
            [[ "$b" == "local" ]] && continue
            # shellcheck source=/dev/null
            source "$bf"
            backend_available 2>/dev/null && available+=("$b")
        done
        [[ ${#available[@]} -eq 0 ]] && die "No remote backends available"
        BACKEND=$(pick "Backend" "${available[@]}")
        load_backend "$BACKEND"
        backend_create
        IS_NEW_MACHINE=true
    elif [[ "$selection" == "local" ]]; then
        BACKEND="local"
        load_backend "$BACKEND"
    else
        # Parse "machine-name (backend)" format
        MACHINE="${selection% (*}"
        BACKEND="${selection##*(}"
        BACKEND="${BACKEND%)}"
        load_backend "$BACKEND"
    fi
else
    load_backend "$BACKEND"
    # If backend + no machine specified, prompt from that backend's machines
    if [[ -z "$MACHINE" && "$BACKEND" != "local" ]]; then
        machines=$(backend_list 2>/dev/null) || true
        if [[ -n "$machines" ]]; then
            MACHINE=$(pick_from "Machine" "$machines")
        fi
    fi
fi

# --- Start machine and ensure SSH ---

backend_start

SSH_TARGET=""
SSH_TARGET=$(backend_ensure_ssh)

# Bootstrap new remote machines with dotfiles
if [[ "$IS_NEW_MACHINE" == true && -n "$SSH_TARGET" ]]; then
    echo "Bootstrapping $MACHINE with dotfiles..." >&2
    if remote_exec 'SUDO="sudo"; [ "$(id -u)" = 0 ] && SUDO=""; $SUDO apt-get update -qq && $SUDO apt-get install -y -qq git curl >/dev/null; git clone https://github.com/kylelundstedt/dotfiles ~/dotfiles 2>/dev/null || true; cd ~/dotfiles && bash install.sh --no-prompt --skip-agents' >&2; then
        echo "Bootstrap complete." >&2
    else
        echo "Bootstrap failed (non-fatal). You can run install.sh manually later." >&2
    fi
fi

# --- Step 2: Pick a project (required) ---

if [[ -z "$PROJECT" ]]; then
    projects=$(backend_list_projects 2>/dev/null) || true
    if [[ -n "$projects" ]]; then
        projects=$(printf '%s\n%s' "$projects" "[+ clone]")
    else
        projects="[+ clone]"
    fi

    PROJECT=$(pick_from "Project" "$projects")

    if [[ "$PROJECT" == "[+ clone]" ]]; then
        printf "GitHub repo (owner/name): " >&2
        read -r repo
        [[ -z "$repo" ]] && die "Repo required"
        # Ensure GitHub host keys are trusted on remote targets
        if [[ -n "$SSH_TARGET" ]]; then
            remote_exec 'mkdir -p ~/.ssh && ssh-keyscan -t ed25519 github.com >> ~/.ssh/known_hosts 2>/dev/null' >/dev/null
        fi
        PROJECT=$(backend_clone_project "$repo")
    fi
fi

# --- Open Zed ---

if [[ -z "$SSH_TARGET" ]]; then
    zed "$PROJECT"
else
    # Remote backend — build ssh:// URI
    sep="/"
    [[ "$PROJECT" == /* ]] && sep=""

    if [[ "$SSH_TARGET" == *:* ]]; then
        ssh_host="${SSH_TARGET%:*}"
        ssh_port="${SSH_TARGET##*:}"
        zed "ssh://${ssh_host}:${ssh_port}${sep}${PROJECT}"
    else
        zed "ssh://${SSH_TARGET}${sep}${PROJECT}"
    fi
fi
